{%- comment -%}
  Section "Mon historique"
  Source : customer.orders (Shopify natif)
  Affiche les 4 derniers livres reçus, tous ordres confondus.
{%- endcomment -%}

<section class="mc-section" id="historique">
  <div class="mc-section__header">
    <h2 class="mc-section__title">Mon historique</h2>
  </div>

  {%- if customer.orders_count > 0 -%}
    {%- assign mc_shown = 0 -%}
    {%- for mc_order in customer.orders -%}
      {%- for mc_li in mc_order.line_items -%}
        {%- if mc_shown < 4 -%}
          {%- assign mc_thumb = mc_li.product.featured_image | img_url: '150x' -%}
          <a href="/products/{{ mc_li.product.handle }}" class="mc-row">

            <div class="mc-row__thumb" style="background-color:#e8f0ea;{%- if mc_thumb != blank %} background-image:url('{{ mc_thumb }}'); background-size:cover; background-position:center;{%- endif -%}"></div>

            <div class="mc-row__info">
              <p class="mc-row__title">{{ mc_li.title }}</p>
              <div class="mc-row__meta">
                <span class="mc-badge" style="color:#2D6A4F; border-color:#2D6A4F;">
                  {{ mc_order.created_at | date: '%d %b %Y' }}
                </span>
                {%- if mc_order.fulfillment_status == 'fulfilled' -%}
                  <span class="mc-row__duration">Livré</span>
                {%- elsif mc_order.fulfillment_status == 'partial' -%}
                  <span class="mc-row__duration">Partiellement livré</span>
                {%- else -%}
                  <span class="mc-row__duration">En cours</span>
                {%- endif -%}
              </div>
            </div>

            <span class="mc-row__chevron" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"/>
              </svg>
            </span>

          </a>
          {%- assign mc_shown = mc_shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}

  {%- else -%}
    <p class="mc-children__empty">Aucune commande pour le moment.</p>
  {%- endif -%}

</section>
