{%- comment -%}
  Modale de création "Créer mon Book Club".
  Rendue une seule fois par la section bookclub-hero. Ouverte par tout élément
  portant l'attribut data-bookclub-open (voir assets/bookclub-signup.js).

  Étapes (chacune est un data-step-key sur .bc-modal__panel, l'ordre DOM fait foi) :
    group   : le club
    account : connexion / continuer sans compte, absente du DOM si customer est déjà présent
    charter : charte du club, étape terminale : à la confirmation, fetch /apps/verty-sync
      action bookclub-create, puis redirection vers le dashboard (assets/bookclub-signup.js,
      data-submit-mode="create").

  Paramètre :
    dashboard_url {String} - URL de redirection après création réussie du club.
{%- endcomment -%}
<bookclub-signup
  class="bookclub-page bc-modal"
  hidden
  data-submit-mode="create"
  data-dashboard-url="{{ dashboard_url | default: '/pages/book-club-dashboard' }}"
  data-customer-id="{{ customer.id }}"
  data-customer-email="{{ customer.email }}"
  data-customer-first-name="{{ customer.first_name | escape }}"
  data-customer-last-name="{{ customer.last_name | escape }}"
>
  <div class="bc-modal__overlay" data-bookclub-close></div>
  <div class="bc-modal__window" role="dialog" aria-modal="true" aria-labelledby="bookclub-signup-heading">
    <div class="bc-modal__top">
      <span class="bc-badge bc-badge--modal" id="bookclub-signup-heading">Book Club</span>
      <button type="button" class="bc-modal__close" data-bookclub-close aria-label="Fermer">{% render 'icon-close' %}</button>
    </div>

    <div class="bc-modal__stepper" data-bookclub-stepper></div>

    <div class="bc-modal__body" data-bookclub-form>
      <!-- Le club -->
      <div class="bc-modal__panel" data-step-key="group" data-step-label="Le club" data-next-label="Continuer">
        <p class="bc-modal__lead">Vous serez le <strong>parent organisateur</strong>. Donnez un nom à votre club, vous inviterez ensuite 6 à 8 familles d'enfants d'âge et de niveau proches avec un lien.</p>
        <label class="bc-field">
          <span class="bc-field__label">Nom du club</span>
          <input type="text" name="club_name" placeholder="Les Explorateurs du mercredi" required>
        </label>
        <div class="bc-field-row">
          <label class="bc-field">
            <span class="bc-field__label">Votre prénom</span>
            <input type="text" name="organizer" placeholder="Camille" required>
          </label>
          <label class="bc-field">
            <span class="bc-field__label">Votre e-mail</span>
            <input type="email" name="email" placeholder="camille@exemple.fr" required>
          </label>
        </div>
        <label class="bc-field">
          <span class="bc-field__label">Ville / quartier</span>
          <input type="text" name="city" placeholder="Lyon 6e">
        </label>
      </div>

      {%- unless customer -%}
      <!-- Le compte -->
      <div class="bc-modal__panel" data-step-key="account" data-step-label="Le compte" data-next-label="Continuer">
        <p class="bc-modal__lead">Connectez-vous pour retrouver les profils lecteurs déjà enregistrés sur votre compte Verty, ou créez-en un.</p>
        <div class="bc-account-choice">
          <a href="{{ routes.storefront_login_url }}?return_to={{ request.path | url_encode }}" class="vbtn vbtn-primary vbtn-navy" data-bookclub-save-draft>Se connecter</a>
          <a href="{{ routes.account_register_url }}" class="vbtn vbtn-secondary vbtn-navy" data-bookclub-save-draft>Créer un compte</a>
        </div>
      </div>
      {%- endunless -%}

      <!-- La charte -->
      <div class="bc-modal__panel" data-step-key="charter" data-step-label="La charte" data-next-label="Créer mon Book Club">
        <p class="bc-modal__lead">La <strong>charte du club</strong> cadre le rôle du parent organisateur. Cochez chaque engagement pour continuer.</p>
        <div class="bc-charter">
          {%- assign charter_items = "Je compose un groupe homogène de 6 à 8 enfants, d'âge et de niveau de lecture proches.|Je m'engage à organiser les rencontres mensuelles et à communiquer les dates aux familles.|Je veille à la rotation des livres et au soin qui leur est apporté par les membres.|Je m'appuie sur le guide de séances et les fiches Verty pour animer les discussions.|Je favorise un climat bienveillant, convivial et respectueux entre les enfants et les familles." | split: '|' -%}
          {%- for item in charter_items -%}
            <label class="bc-charter__item">
              <input type="checkbox" name="charter" value="{{ forloop.index }}" required>
              <span>{{ item }}</span>
            </label>
          {%- endfor -%}
        </div>
        <p class="bc-modal__note">En confirmant, votre Book Club est créé et vous serez redirigé vers son dashboard.</p>
        <p class="bc-modal__error" data-bookclub-error hidden>Une erreur est survenue, merci de réessayer.</p>
      </div>
    </div>

    <div class="bc-modal__footer">
      <button type="button" class="bc-modal__back" data-bookclub-back>Annuler</button>
      <div class="bc-modal__footer-right">
        <button type="button" class="vbtn vbtn-primary vbtn-navy" data-bookclub-next disabled>Continuer</button>
      </div>
    </div>
  </div>
</bookclub-signup>
