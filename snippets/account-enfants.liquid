{%- comment -%}
  Section "Mes enfants"
  Source : customer.metafields.verty.children.value (liste JSON)
  Tant que le métachamp n'est pas actif, les placeholders HTML s'affichent.
{%- endcomment -%}

{%- assign mc_children = customer.metafields.verty.children.value -%}

{% render 'account-child-modal' %}

<section class="mc-section" id="enfants">
  <div class="mc-section__header">
    <h2 class="mc-section__title">Mes enfants</h2>
  </div>

  <div class="mc-children">

    {%- if mc_children -%}
      {%- for mc_child in mc_children -%}
        {% render 'account-child-card', mc_child: mc_child %}
      {%- endfor -%}

    {%- else -%}
      {%- comment -%} PLACEHOLDER — supprimer quand verty.children est actif {%- endcomment -%}

      <div class="mc-child">
        <div class="mc-child__avatar" style="background-color: #c8eddb; color: #1a5c3a;" aria-hidden="true">E</div>
        <div class="mc-child__info">
          <p class="mc-child__name">Emma</p>
          <p class="mc-child__age">7 ans</p>
        </div>
        <button type="button" class="mc-child__btn" onclick="mcOpenChildModal({})">Gérer</button>
      </div>

      <div class="mc-child">
        <div class="mc-child__avatar" style="background-color: #c4d4f0; color: #1a3a6a;" aria-hidden="true">L</div>
        <div class="mc-child__info">
          <p class="mc-child__name">Lucas</p>
          <p class="mc-child__age">10 ans</p>
        </div>
        <button type="button" class="mc-child__btn" onclick="mcOpenChildModal({})">Gérer</button>
      </div>

    {%- endif -%}

  </div>
</section>
