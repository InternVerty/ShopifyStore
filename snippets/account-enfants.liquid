{%- comment -%}
  Section "Mes enfants"
  Source : customer.metafields.custom.dataenfant.value
{%- endcomment -%}

{%- assign mc_children = customer.metafields.custom.dataenfant.value -%}
{%- assign mc_avatar_bgs   = '#c8eddb,#c4d4f0,#f0e4c8,#e8c8f0' | split: ',' -%}
{%- assign mc_avatar_texts = '#1a5c3a,#1a3a6a,#6a4a1a,#5a1a6a' | split: ',' -%}

{% render 'account-child-modal' %}

<section class="mc-section" id="enfants">
  <div class="mc-section__header">
    <h2 class="mc-section__title">Mes enfants</h2>
    <button type="button" class="mc-section__add" onclick="mcOpenChildModal({})">+ Ajouter</button>
  </div>

  <div class="mc-children">

    {%- assign mc_prenoms = mc_children | map: 'prenom' | join: '' -%}
    {%- if mc_children != blank and mc_prenoms != blank -%}
      {%- for mc_child in mc_children -%}
        {%- if mc_child.prenom != blank -%}
          {%- assign mc_ci = forloop.index0 | modulo: 4 -%}
          {% render 'account-child-card',
            mc_child: mc_child,
            mc_index: forloop.index0,
            mc_avatar_color: mc_avatar_bgs[mc_ci],
            mc_avatar_text_color: mc_avatar_texts[mc_ci]
          %}
        {%- endif -%}
      {%- endfor -%}

    {%- else -%}
      <p class="mc-children__empty">Aucun enfant enregistré pour le moment.</p>
    {%- endif -%}

  </div>
</section>
