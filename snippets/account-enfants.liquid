{%- comment -%}
  Section "Mes enfants"
  Source : customer.metafields.custom.dataenfant.value
{%- endcomment -%}

{%- assign mc_children = customer.metafields.custom.dataenfant.value -%}
{%- assign mc_avatar_bgs   = '#c8eddb,#c4d4f0,#f0e4c8,#e8c8f0' | split: ',' -%}
{%- assign mc_avatar_texts = '#1a5c3a,#1a3a6a,#6a4a1a,#5a1a6a' | split: ',' -%}

{% render 'account-child-modal' %}

<style>
  .mc-info-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }
  .mc-info-btn {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    border: 1.5px solid #ccc;
    background: transparent;
    color: #aaa;
    font-size: 0.65em;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    padding: 0;
    font-family: inherit;
    transition: border-color 0.15s, color 0.15s;
    flex-shrink: 0;
  }
  .mc-info-btn:hover {
    border-color: #1a5c3a;
    color: #1a5c3a;
  }
  .mc-info-popover {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 280px;
    background: #fff;
    border: 1.5px solid #e8e8e8;
    border-radius: 12px;
    padding: 14px 16px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.09);
    z-index: 200;
  }
  .mc-info-popover.is-open { display: block; }
  .mc-info-popover__title {
    font-size: 0.85em;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 6px;
  }
  .mc-info-popover__body {
    font-size: 0.8em;
    color: #666;
    line-height: 1.55;
    margin: 0;
  }
</style>

<section class="mc-section" id="enfants">
  <div class="mc-section__header">
    <div style="display:flex; align-items:center; gap:8px;">
      <h2 class="mc-section__title">Mes sélections personnalisées</h2>
      <div class="mc-info-wrap">
        <button type="button" class="mc-info-btn" id="mc-enfants-info-btn" aria-label="En savoir plus sur la Sélection Personnalisée">?</button>
        <div class="mc-info-popover" id="mc-enfants-info-popover" aria-hidden="true">
          <p class="mc-info-popover__title">C'est quoi la Sélection Personnalisée?</p>
          <p class="mc-info-popover__body">Chaque mois, nous choisissons pour chaque enfant des livres adaptés à son âge, sa classe, son niveau de lecture et ses centres d'intérêt. Plus le profil est complet, plus la sélection est précise !</p>
        </div>
      </div>
    </div>
    <button type="button" class="mc-section__add" onclick="mcOpenChildModal({})">+ Ajouter un enfant</button>
  </div>

  <div class="mc-children">

    {%- assign mc_prenoms = mc_children | map: 'prenom' | join: '' -%}
    {%- if mc_children != blank and mc_prenoms != blank -%}
      {%- for mc_child in mc_children -%}
        {%- if mc_child.prenom != blank -%}
          {%- assign mc_ci = forloop.index0 | modulo: 4 -%}
          {% render 'account-child-card',
            mc_child: mc_child,
            mc_index: forloop.index0,
            mc_avatar_color: mc_avatar_bgs[mc_ci],
            mc_avatar_text_color: mc_avatar_texts[mc_ci]
          %}
        {%- endif -%}
      {%- endfor -%}

    {%- else -%}
      <p class="mc-children__empty">Aucun enfant enregistré pour le moment.</p>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var btn = document.getElementById('mc-enfants-info-btn');
  var pop = document.getElementById('mc-enfants-info-popover');
  if (!btn || !pop) return;

  btn.addEventListener('click', function (e) {
    e.stopPropagation();
    var open = pop.classList.toggle('is-open');
    pop.setAttribute('aria-hidden', open ? 'false' : 'true');
  });

  document.addEventListener('click', function () {
    pop.classList.remove('is-open');
    pop.setAttribute('aria-hidden', 'true');
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      pop.classList.remove('is-open');
      pop.setAttribute('aria-hidden', 'true');
    }
  });
})();
</script>
