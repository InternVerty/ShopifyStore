{%- comment -%}
  Section "Mes enfants"

  Source de données :
    customer.metafields.verty.children.value  →  liste JSON d'objets enfant
    Format attendu par item :
      { "name": "", "age": 8, "initial": "L", "avatar_color": "#hex", "avatar_text_color": "#hex", "url": "/..." }

  Les données PLACEHOLDER ci-dessous sont supprimées dès que le métachamp est actif.
{%- endcomment -%}

{%- assign mc_children = customer.metafields.verty.children.value -%}

{%- unless mc_children -%}
  {%- assign mc_children = '[
    {"name":"Léa","age":8,"initial":"L","avatar_color":"#c8eddb","avatar_text_color":"#1a5c3a","url":"#"},
    {"name":"Tom","age":11,"initial":"T","avatar_color":"#c4d4f0","avatar_text_color":"#1a3a6a","url":"#"}
  ]' | parse_json -%}
{%- endunless -%}

{%- if mc_children != blank -%}
  <section class="mc-section" id="enfants">
    <div class="mc-section__header">
      <h2 class="mc-section__title">Mes enfants</h2>
    </div>

    <div class="mc-children">
      {%- for mc_child in mc_children -%}
        {% render 'account-child-card', mc_child: mc_child %}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}
