{%- comment -%}
  Sidebar du compte : profil, bookclub promo, navigation
{%- endcomment -%}

{%- assign mc_bio = customer.metafields.verty.bio.value | default: '' -%}

<style>
  .mc-bookclub-card {
    background: #ADBEEA;
    border-radius: 16px;
    padding: 22px 20px;
  }
  .mc-bookclub-card__label {
    font-size: 1.0rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #1E3354;
    margin: 0 0 6px;
  }
  .mc-bookclub-card__name {
    font-size: 1.7rem;
    font-weight: 700;
    color: #1A2C4A;
    margin: 0 0 10px;
  }
  .mc-bookclub-card__desc {
    font-size: 1.25rem;
    color: #3A5A7A;
    margin: 0;
    line-height: 1.6;
  }
  .mc-bookclub-card__btn {
    display: inline-block;
    margin-top: 16px;
    padding: 8px 20px;
    background: #1E3354;
    border-radius: 99px;
    font-size: 1.3rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.15s;
  }
  .mc-bookclub-card__btn:hover { opacity: 0.85; }
</style>

<aside class="mc-sidebar">

  {%- comment -%} — Profil — {%- endcomment -%}
  <div class="mc-card mc-profile">
    <p class="mc-profile__name">{{ customer.first_name }} {{ customer.last_name }}</p>
    {%- if mc_bio != blank -%}
      <p class="mc-profile__bio">{{ mc_bio }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} — Bookclub promo — {%- endcomment -%}
  <div class="mc-bookclub-card">
    <p class="mc-bookclub-card__label">Nouveauté</p>
    <p class="mc-bookclub-card__name">Le Bookclub</p>
    <p class="mc-bookclub-card__desc">Un club de lecture mensuel avec des sélections pensées pour vos enfants.</p>
    <a href="/pages/bookclub" class="mc-bookclub-card__btn">Découvrir →</a>
  </div>

  {%- comment -%} — Navigation — {%- endcomment -%}
  <nav aria-label="Navigation du compte">
    <ul class="mc-nav">
      <li>
        <a href="#favoris" class="mc-nav__item mc-nav__item--active">
          <svg class="mc-nav__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
          Mes favoris
        </a>
      </li>
      <li>
        <a href="#historique" class="mc-nav__item">
          <svg class="mc-nav__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Mon historique
        </a>
      </li>
      <li>
        <a href="#enfants" class="mc-nav__item">
          <svg class="mc-nav__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
          </svg>
          Mes enfants
        </a>
      </li>
      <li>
        <a href="#parametres" class="mc-nav__item">
          <svg class="mc-nav__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
          Paramètres
        </a>
      </li>
      <li style="margin-top: 6px; border-top: 1px solid #f0f0f0; padding-top: 6px;">
        <a href="{{ routes.account_logout_url }}" class="mc-nav__item mc-nav__item--logout">
          <svg class="mc-nav__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          Se déconnecter
        </a>
      </li>
    </ul>
  </nav>

</aside>
