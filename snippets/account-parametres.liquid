{%- comment -%}
  Section "Paramètres du compte"

  E-mail et langue viennent de l'objet customer Shopify natif.
  Newsletter → TODO: brancher sur customer.metafields.verty.newsletter_enabled.value
  Mot de passe → redirige vers le formulaire natif Shopify
{%- endcomment -%}

{%- assign mc_newsletter = customer.metafields.verty.newsletter_enabled.value | default: 'Activée' -%}

<section class="mc-section" id="parametres">
  <div class="mc-section__header">
    <h2 class="mc-section__title">Paramètres du compte</h2>
  </div>

  <div class="mc-setting">
    <span class="mc-setting__label">Adresse e-mail</span>
    <div class="mc-setting__right">
      <span class="mc-setting__value">{{ customer.email }}</span>
      <a href="{{ routes.account_url }}" class="mc-setting__edit">Modifier</a>
    </div>
  </div>

  <div class="mc-setting">
    <span class="mc-setting__label">Mot de passe</span>
    <div class="mc-setting__right">
      <span class="mc-setting__value">••••••••</span>
      <a href="{{ routes.account_url }}" class="mc-setting__edit">Modifier</a>
    </div>
  </div>

  <div class="mc-setting">
    <span class="mc-setting__label">Newsletter</span>
    <div class="mc-setting__right">
      <span class="mc-setting__value">{{ mc_newsletter }}</span>
      <a href="#" class="mc-setting__edit">Modifier</a>
    </div>
  </div>

  <div class="mc-setting">
    <span class="mc-setting__label">Langue</span>
    <div class="mc-setting__right">
      <span class="mc-setting__value">{{ request.locale.name }}</span>
      <a href="#" class="mc-setting__edit">Modifier</a>
    </div>
  </div>

</section>
