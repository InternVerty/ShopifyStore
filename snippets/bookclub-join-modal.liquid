{%- comment -%}
  Modale "Ajouter mon enfant" pour rejoindre un club Book Club existant.
  Même custom element et même JS que snippets/bookclub-signup-modal.liquid
  (assets/bookclub-signup.js est générique par data-step-key, aucune modification requise).

  Paramètre :
    club_name {String} - nom du club affiché, transmis en champ caché "club_name"
      pour que collectProperties() dans le JS continue de fonctionner à l'identique.
{%- endcomment -%}
{%- liquid
  assign bc_product = all_products['bookclub-abonnement-1-an']

  assign mc_children = customer.metafields.custom.dataenfant.value
  assign mc_prenoms = mc_children | map: 'prenom' | join: ''
  assign has_children = false
  if customer and mc_children != blank and mc_prenoms != blank
    assign has_children = true
  endif
-%}
<bookclub-signup class="bookclub-page bc-modal" hidden data-product-handle="bookclub-abonnement-1-an">
  <div class="bc-modal__overlay" data-bookclub-close></div>
  <div class="bc-modal__window" role="dialog" aria-modal="true" aria-labelledby="bookclub-join-heading">
    <div class="bc-modal__top">
      <span class="bc-badge bc-badge--modal" id="bookclub-join-heading">Rejoindre le club</span>
      <button type="button" class="bc-modal__close" data-bookclub-close aria-label="Fermer">{% render 'icon-close' %}</button>
    </div>

    <div class="bc-modal__stepper" data-bookclub-stepper></div>

    <div class="bc-modal__body" data-bookclub-form>
      {%- if customer -%}
        <!-- Déjà connecté : coordonnées reprises du compte, pas d'étape dédiée -->
        <input type="hidden" name="club_name" value="{{ club_name | escape }}">
        <input type="hidden" name="organizer" value="{{ customer.first_name | escape }}">
        <input type="hidden" name="email" value="{{ customer.email | escape }}">
        <input type="hidden" name="city" value="{{ customer.default_address.city | escape }}">
      {%- else -%}
      <!-- Rejoindre -->
      <div class="bc-modal__panel" data-step-key="group" data-step-label="Rejoindre" data-next-label="Continuer">
        <p class="bc-modal__lead">Vous rejoignez <strong>{{ club_name | escape }}</strong>. Donnez vos coordonnées pour continuer.</p>
        <input type="hidden" name="club_name" value="{{ club_name | escape }}">
        <div class="bc-field-row">
          <label class="bc-field">
            <span class="bc-field__label">Votre prénom</span>
            <input type="text" name="organizer" placeholder="Camille" required>
          </label>
          <label class="bc-field">
            <span class="bc-field__label">Votre e-mail</span>
            <input type="email" name="email" placeholder="camille@exemple.fr" required>
          </label>
        </div>
        <label class="bc-field">
          <span class="bc-field__label">Ville / quartier</span>
          <input type="text" name="city" placeholder="Lyon 6e">
        </label>
      </div>

      <!-- Compte -->
      <div class="bc-modal__panel" data-step-key="account" data-step-label="Compte" data-next-label="Continuer">
        <p class="bc-modal__lead">Connectez-vous pour retrouver les profils lecteurs déjà enregistrés sur votre compte Verty, ou continuez sans compte.</p>
        <div class="bc-account-choice">
          <a href="{{ routes.account_login_url }}" class="vbtn vbtn-primary vbtn-navy" data-bookclub-save-draft>Se connecter</a>
          <button type="button" class="vbtn vbtn-secondary vbtn-navy" data-bookclub-guest>Continuer en tant qu'invité</button>
        </div>
      </div>
      {%- endif -%}

      <!-- Profil lecteur -->
      <div class="bc-modal__panel" data-step-key="profile" data-step-label="Profil lecteur" data-next-label="Continuer">
        <p class="bc-modal__lead">Le <strong>profil lecteur</strong> de votre enfant permet à Verty d'affiner la sélection initiale du club.</p>

        {%- if has_children -%}
          <fieldset class="bc-field" data-bookclub-child-picker>
            <legend class="bc-field__label">Pour quel enfant ?</legend>
            <div class="bc-child-picker">
              {%- for mc_child in mc_children -%}
                {%- if mc_child.prenom != blank -%}
                  {%- assign mc_age = '' -%}
                  {%- if mc_child.naissance != blank -%}
                    {%- assign mc_birth_ts = mc_child.naissance | date: '%s' | plus: 0 -%}
                    {%- assign mc_now_ts = 'now' | date: '%s' | plus: 0 -%}
                    {%- assign mc_age = mc_now_ts | minus: mc_birth_ts | divided_by: 31557600 -%}
                  {%- endif -%}
                  {%- assign mc_themes_joined = mc_child.themes | join: ', ' -%}
                  <label class="bc-child-card">
                    <input type="radio" name="existing_child" value="{{ forloop.index0 }}"
                      data-prenom="{{ mc_child.prenom | escape }}"
                      data-naissance="{{ mc_child.naissance }}"
                      data-genre="{{ mc_child.genre | escape }}"
                      data-classe="{{ mc_child.classe | escape }}"
                      data-niveau="{{ mc_child.niveau | escape }}"
                      data-themes="{{ mc_themes_joined | escape }}">
                    <span class="bc-child-card__name">{{ mc_child.prenom }}</span>
                    <span class="bc-child-card__meta">{%- if mc_age != blank -%}{{ mc_age }} ans{%- endif -%}{%- if mc_age != blank and mc_child.classe != blank %}, {% endif -%}{{ mc_child.classe }}</span>
                    {%- if mc_child.niveau != blank -%}
                      <span class="bc-child-card__niveau">{{ mc_child.niveau }}</span>
                    {%- endif -%}
                    {%- if mc_child.themes != blank and mc_child.themes.size > 0 -%}
                      <div class="bc-child-card__themes">
                        {%- for mc_theme in mc_child.themes -%}
                          <span class="bc-child-card__theme-chip">{{ mc_theme }}</span>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </label>
                {%- endif -%}
              {%- endfor -%}
              <label class="bc-child-card bc-child-card--new">
                <input type="radio" name="existing_child" value="new">
                <span class="bc-child-card__name">Ajouter un enfant</span>
              </label>
            </div>
          </fieldset>
        {%- endif -%}

        <div data-bookclub-child-manual{% if has_children %} hidden{% endif %}>
          <div class="bc-field-row">
            <label class="bc-field">
              <span class="bc-field__label">Prénom</span>
              <input type="text" name="child_prenom" placeholder="Prénom de l'enfant" autocomplete="off" required>
            </label>
            <label class="bc-field">
              <span class="bc-field__label">Date de naissance</span>
              <input type="date" name="child_naissance">
            </label>
          </div>
          <fieldset class="bc-field">
            <legend class="bc-field__label">Genre</legend>
            <div class="bc-toggle-group">
              {% assign gen = "Garçon,Fille" | split: ',' -%}
              {%- for genre in gen -%}
                <label class="bc-toggle"><input type="radio" name="child_genre" value="{{ genre }}"><span>{{ genre }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <fieldset class="bc-field">
            <legend class="bc-field__label">Classe</legend>
            <div class="bc-toggle-group">
              {%- assign classes = 'Crèche,Petite section,Moyenne section,Grande section,CP,CE1,CE2,CM1,CM2,6ème,5ème,4ème,3ème,2nde,1ère,Terminale' | split: ',' -%}
              {%- for classe in classes -%}
                <label class="bc-toggle bc-toggle--sm"><input type="radio" name="child_classe" value="{{ classe }}"><span>{{ classe }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <fieldset class="bc-field">
            <legend class="bc-field__label">Niveau de lecture</legend>
            <div class="bc-toggle-group">
              {%- assign niveaux = 'Au-dessus du niveau de sa classe,Conforme au niveau de la classe,En-dessous du niveau de sa classe' | split: ',' -%}
              {%- for niveau in niveaux -%}
                <label class="bc-toggle"><input type="radio" name="child_niveau" value="{{ niveau }}"><span>{{ niveau }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <fieldset class="bc-field">
            <legend class="bc-field__label">Thèmes préférés <span class="bc-field__hint" data-bookclub-themes-hint>5 choix maximum</span></legend>
            <div class="bc-toggle-group" data-bookclub-themes-group>
              {%- assign themes = 'Humour,Aventures,Histoire,Animaux,Emotions,Documentaire,Spiritualité,Amitié,Famille,Nature,Arts,Contes et légendes,Sport,Voyages,Policiers,Fantastique,BD,Mythologie,Biographies,Mystère,Classiques,Science fiction,Intrigue' | split: ',' -%}
              {%- for theme in themes -%}
                <label class="bc-toggle bc-toggle--sm"><input type="checkbox" name="child_themes" value="{{ theme }}"><span>{{ theme }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>
          <label class="bc-field">
            <span class="bc-field__label">Remarque</span>
            <textarea name="child_remarque" rows="3" placeholder="Informations utiles pour la sélection"></textarea>
          </label>
        </div>
      </div>

      <!-- La charte -->
      <div class="bc-modal__panel" data-step-key="charter" data-step-label="La charte" data-next-label="Accepter la charte">
        <p class="bc-modal__lead">La <strong>charte du club</strong> cadre les engagements de chaque famille membre. Cochez chaque engagement pour continuer.</p>
        <div class="bc-charter">
          {%- assign charter_items = "Je m'engage à participer aux rencontres mensuelles de septembre à mai.|Je veille à la rotation des livres et au soin qui leur est apporté.|J'accepte que mon enfant complète son profil lecteur pour affiner la sélection du club.|Je respecte le rythme et l'organisation fixés par le parent organisateur." | split: '|' -%}
          {%- for item in charter_items -%}
            <label class="bc-charter__item">
              <input type="checkbox" name="charter" value="{{ forloop.index }}" required>
              <span>{{ item }}</span>
            </label>
          {%- endfor -%}
        </div>
      </div>

      <!-- Récap + inscription au checkout -->
      <div class="bc-modal__panel" data-step-key="payment" data-step-label="Paiement" data-next-label="Ajouter au panier">
        <div class="bc-modal__recap">
          <div class="bc-modal__recap-head">
            <div>
              <div class="bc-modal__recap-kicker">Forfait annuel, 1 membre</div>
              <div class="bc-modal__recap-club" data-bookclub-recap-name>{{ club_name | escape }}</div>
            </div>
            <div class="bc-modal__recap-price">
              {%- if bc_product -%}{{ bc_product.price | money_without_trailing_zeros }}{%- else -%}39&nbsp;€{%- endif -%}
            </div>
          </div>
          <ul class="bc-modal__recap-list">
            <li>{% render 'icon', icon: 'check_mark', width: 18, height: 18 %} Sélection de livres, plus 2 livres offerts</li>
            <li>{% render 'icon', icon: 'check_mark', width: 18, height: 18 %} Carnet du lecteur, marque-page et tote bag</li>
            <li>{% render 'icon', icon: 'check_mark', width: 18, height: 18 %} Guide de séances, fiches livres et rotation</li>
            <li>{% render 'icon', icon: 'check_mark', width: 18, height: 18 %} Service client Verty dédié</li>
          </ul>
        </div>
        <p class="bc-modal__note">En continuant, votre inscription est ajoutée au panier avec les informations que vous venez de renseigner. Vous serez redirigé vers le paiement sécurisé Shopify pour la finaliser.</p>
        <p class="bc-modal__error" data-bookclub-error hidden>Une erreur est survenue, merci de réessayer.</p>
      </div>
    </div>

    <div class="bc-modal__footer">
      <button type="button" class="bc-modal__back" data-bookclub-back>Annuler</button>
      <div class="bc-modal__footer-right">
        <button type="button" class="vbtn vbtn-primary vbtn-navy" data-bookclub-next disabled>Continuer</button>
      </div>
    </div>
  </div>
</bookclub-signup>
