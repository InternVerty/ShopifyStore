        "temoignage_2": { "type": "temoignage", "settings": { "photo_asset": "bookclub-testimonial-a.jpg", "quote": "Je redoutais d'animer les séances. Le guide et les fiches font tout le travail : j'arrive à chaque séance sans rien préparer, et les enfants parlent pendant trois quarts d'heure.", "author": "Marc, 41 ans", "role": "parent organisateur, club de Nantes" } },
