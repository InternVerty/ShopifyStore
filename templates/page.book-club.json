    "bookclub_faq": {
      "type": "faq",
      "name": "Book Club, FAQ",
      "settings": {
        "heading": "Tout ce qu'un parent veut savoir",
        "heading_align": "text-center",
        "color_scheme": "none",
        "full_width": true
      },
      "blocks": {
        "faq_1": { "type": "question", "settings": { "icon": "none", "heading": "Combien coûte le Book Club ?", "text": "<p>Un forfait unique de 39 € par enfant et par an, réglé à l'inscription. Il inclut le kit de démarrage complet : la sélection de livres de l'année, 2 livres offerts par enfant, le carnet du lecteur, le marque-page, le tote bag, le guide de séances, les fiches livres et l'accès au service client dédié.</p>" } },
        "faq_2": { "type": "question", "settings": { "icon": "none", "heading": "Qui peut créer un club ?", "text": "<p>N'importe quel parent de la communauté Verty. Le parent organisateur crée le groupe sur cette page, partage le lien d'invitation à son entourage et constitue un groupe de 6 à 8 enfants d'âge et de niveau de lecture proches.</p>" } },
        "faq_3": { "type": "question", "settings": { "icon": "none", "heading": "Faut-il être un bon animateur ?", "text": "<p>Aucune expérience requise. Le guide de séances, les fiches livres et les questions de discussion sont fournis et prêts à l'emploi. Le parent organisateur est accompagné pas à pas, et dispose d'un service client Verty dédié.</p>" } },
        "faq_4": { "type": "question", "settings": { "icon": "none", "heading": "Comment sont choisis les livres ?", "text": "<p>Chaque enfant remplit un court questionnaire qui établit son profil lecteur, âge, niveau, centres d'intérêt. Verty affine alors la sélection initiale du club. Tous les titres sont lus, notés et recommandés par le comité de lecture.</p>" } },
        "faq_5": { "type": "question", "settings": { "icon": "none", "heading": "Comment fonctionne la rotation des livres ?", "text": "<p>Les livres circulent entre les membres au fil de l'année grâce à la fiche de rotation. À chaque séance mensuelle, chaque enfant choisit son prochain titre dans la sélection disponible, sans jamais sortir du cadre validé par le comité.</p>" } },
        "faq_6": { "type": "question", "settings": { "icon": "none", "heading": "À partir de quel âge ?", "text": "<p>Le club réunit des enfants d'âge et de niveau de lecture proches, autour d'un format unique : un temps de jeu, le carnet du lecteur, un goûter convivial puis la discussion guidée. C'est ce rythme partagé qui crée le lien entre les membres.</p>" } },
        "faq_7": { "type": "question", "settings": { "icon": "none", "heading": "Le club se renouvelle-t-il ?", "text": "<p>Oui. Si le club fonctionne, le groupe se reconstitue l'année suivante. Le parent organisateur bénéficie par ailleurs de 5 % de remise sur sa prochaine commande Verty pour chaque club créé.</p>" } }
      },
      "block_order": ["faq_1", "faq_2", "faq_3", "faq_4", "faq_5", "faq_6", "faq_7"]
