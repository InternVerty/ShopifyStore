<link rel="stylesheet" href="{{ 'custom-featured-collection.css' | asset_url }}" media="print" onload="this.media='all'"> 

<div class="more">

        <div class="featured-collection-text{% unless section.settings.image.aspect_ratio == "fill" %} flex flex-col grow{% endunless %}{% if bg_color %} p-6{% else %} mt-6{% endif %}{% unless color_scheme == 'none' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}">
          

        {% if product.metafields.custom.avis_comite != blank %}
          <div class="more">
            <input class="more__toggle" type="checkbox" id="more-{{ section.id }}" style="position:absolute;left:-9999px;">
            <div class="more__text rte">
              {{ product.metafields.custom.avis_comite | newline_to_br }}
            </div>
            <label class="more__btn" for="more-{{ section.id }}">Voir plus</label>
          </div>
        {% endif %}


        {%- if section.settings.button_label != blank -%}
          <a class="{{ section.settings.button_style }} block mt-8 w-full" {% if section.settings.link_url != blank %}href="{{ section.settings.link_url }}"{% else %}role="link"aria-disabled="true"{% endif %}>
            {{- section.settings.button_label | escape -}}
          </a>
        {%- endif -%}

      </div>
    </div>