<section class="bookclub-page bc-piliers" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="bc-piliers__header">
      {%- if section.settings.kicker != blank -%}<p class="bc-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="bc-section-title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="bc-piliers__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'pilier' -%}
          {%- assign bc_points = block.settings.points | split: "
" -%}
          <div class="bc-card bc-piliers__card" {{ block.shopify_attributes }}>
            <span class="bc-piliers__card-icon">{% render 'icon', icon: block.settings.icon, width: 24, height: 24 %}</span>
            <span class="bc-badge bc-piliers__card-tag">{{ block.settings.tag | escape }}</span>
            <h3 class="bc-piliers__card-title">{{ block.settings.heading | escape }}</h3>
            <ul class="bc-piliers__card-list">
              {%- for bc_point in bc_points -%}
                {%- assign bc_point_trim = bc_point | strip -%}
                {%- if bc_point_trim != blank -%}
                  <li>{% render 'icon', icon: 'check_mark', width: 14, height: 14 %}{{ bc_point_trim }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Book Club, piliers",
  "tag": "section",
  "class": "bookclub-piliers-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Ce qui rend le club unique"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Trois piliers, une même promesse"
    }
  ],
  "blocks": [
    {
      "type": "pilier",
      "name": "Pilier",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "star", "label": "Star" },
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "check_mark", "label": "Check mark" }
          ],
          "default": "star"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Étiquette"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "points",
          "label": "Points (un par ligne)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Book Club, piliers",
      "blocks": [
        {
          "type": "pilier",
          "settings": {
            "icon": "star",
            "tag": "Qualité",
            "heading": "Le comité de lecture Verty au cœur",
            "points": "Des livres lus, notés et recommandés par le comité.\nAucun risque éditorial pour le parent.\nLe sceau Verty s'applique aux livres du club, comme sur le site."
          }
        },
        {
          "type": "pilier",
          "settings": {
            "icon": "chat_bubble",
            "tag": "Communauté",
            "heading": "Les copains comme moteur",
            "points": "6 à 8 enfants d'âge et de niveau proches par groupe.\nLa recommandation entre amis, déclencheur n° 1 de lecture.\nDes échanges réguliers, au rythme mensuel."
          }
        },
        {
          "type": "pilier",
          "settings": {
            "icon": "check_mark",
            "tag": "Clé en main",
            "heading": "Un parent guidé pas à pas",
            "points": "Fiches livres prêtes à l'emploi pour animer.\nGuide de séances et questions de discussion fournies.\nAucune expérience préalable requise."
          }
        }
      ]
    }
  ]
}
{% endschema %}
