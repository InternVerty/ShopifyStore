{{ 'coffret-landing.css' | asset_url | stylesheet_tag }}

<section class="coffret-page cf-final" id="commander" data-section-id="{{ section.id }}">
  <div class="cf-final__inner">
    {%- if section.settings.heading != blank -%}<h2 class="cf-final__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="cf-final__text">{{ section.settings.text | escape }}</p>{%- endif -%}
    <div class="cf-final__actions">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/pages/coffret' }}" class="cf-btn cf-btn--lg">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.share_label != blank -%}
        <a href="{{ section.settings.share_url | default: '#partager' }}" class="cf-sharelink cf-sharelink--circle">
          <span class="cf-sharelink__disc">{% render 'coffret-landing-icon', name: 'share', size: 20 %}</span>
          {{ section.settings.share_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.show_shelf -%}
  <div class="coffret-page cf-shelf" aria-hidden="true">
    <div class="cf-shelf__row">
      <img src="{{ 'coffret-landing-cover-ithaque.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(0);">
      <img src="{{ 'coffret-landing-cover-appel-foret.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(7px);">
      <img src="{{ 'coffret-landing-cover-club-cinq.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(-3px);">
      <img src="{{ 'coffret-landing-cover-vango.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(7px);">
      <img src="{{ 'coffret-landing-cover-alma.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(0);">
      <img src="{{ 'coffret-landing-cover-fidem.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(-3px);">
      <img src="{{ 'coffret-landing-cover-bayard.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(7px);">
      <img src="{{ 'coffret-landing-cover-gabriel.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(0);">
      <img src="{{ 'coffret-landing-cover-trois-couleurs.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(-3px);">
      <img src="{{ 'coffret-landing-cover-balme-2.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(7px);">
      <img src="{{ 'coffret-landing-cover-evguenia.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(0);">
      <img src="{{ 'coffret-landing-cover-brisaine.jpg' | asset_url }}" alt="" loading="lazy" width="88" style="transform:translateY(7px);">
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Coffret, CTA final",
  "tag": "div",
  "class": "coffret-cta-final-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le plus beau des cadeaux, choisi comme si vous aviez le temps." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "39,00€ + 4,90€ de livraison. Deux minutes pour nous parler de lui, le comité fait le reste, vous validez." },
    { "type": "text", "id": "cta_label", "label": "Bouton principal", "default": "Je commande son coffret" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton principal", "info": "Par défaut : /pages/coffret" },
    { "type": "text", "id": "share_label", "label": "Lien secondaire", "default": "Envoyer cette idée cadeau" },
    { "type": "text", "id": "share_url", "label": "Cible du lien secondaire", "default": "#partager" },
    { "type": "checkbox", "id": "show_shelf", "label": "Afficher l'étagère de couvertures", "default": true }
  ],
  "presets": [
    { "name": "Coffret, CTA final" }
  ]
}
{% endschema %}
