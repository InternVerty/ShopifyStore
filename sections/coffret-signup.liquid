{%- comment -%}
  Formulaire du Coffret Verty, affiché en popup (template page.coffret).
  Reprend les questions du formulaire Tally "Formulaire Coffret"
  (tally.so/r/yPBVWd) et le style du popup "La Sélection Verty"
  (selection-signup.css). Il s'ouvre depuis tout élément portant l'attribut
  data-coffret-open, comme les boutons de la landing (sections coffret-*).

  À la validation, le produit coffret est ajouté au panier avec les réponses en
  propriétés de ligne (comme le bookclub), puis on redirige vers le panier.
  Plus d'appel à /apps/verty-sync (voir assets/coffret-signup.js).
{%- endcomment -%}

{%- render 'coffret-signup-modal',
  product_handle: section.settings.product.handle,
  privacy_url: section.settings.privacy_url
-%}

{% schema %}
{
  "name": "Coffret, formulaire",
  "tag": "section",
  "class": "coffret-signup-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit coffret",
      "info": "Ajouté au panier à la validation. Par défaut : le produit « Coffret Verty » (handle coffret-verty)."
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Page de protection des données"
    }
  ],
  "presets": [
    { "name": "Coffret, formulaire" }
  ]
}
{% endschema %}
