{%- comment -%}
  Formulaire du Coffret Verty, affiché en popup (template page.coffret).
  Reprend les questions du formulaire Tally "Formulaire Coffret"
  (tally.so/r/yPBVWd) et le style du popup "La Sélection Verty"
  (selection-signup.css). Il s'ouvre depuis tout élément portant l'attribut
  data-coffret-open, comme les boutons de la landing (sections coffret-*).

  À la validation, le produit coffret est ajouté au panier avec les réponses en
  propriétés de ligne (comme le bookclub), puis on redirige vers le panier.
  Plus d'appel à /apps/verty-sync (voir assets/coffret-signup.js).
{%- endcomment -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap">
{{ 'selection-signup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'coffret-signup.js' | asset_url }}" defer="defer"></script>

<coffret-signup
  class="vs-modal vs-modal--marine"
  hidden
  data-customer-id="{{ customer.id }}"
  data-product-handle="{{ section.settings.product.handle | default: 'coffret' }}"
  data-cart-url="{{ routes.cart_url }}"
  data-privacy-url="{{ section.settings.privacy_url | default: '/pages/donnees-personnelles' }}"
  data-customer-email="{{ customer.email | escape }}"
  data-customer-first-name="{{ customer.first_name | escape }}"
  data-customer-last-name="{{ customer.last_name | escape }}"
>
  <div data-vs-root></div>
</coffret-signup>

{% schema %}
{
  "name": "Coffret, formulaire",
  "tag": "section",
  "class": "coffret-signup-section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit coffret",
      "info": "Ajouté au panier à la validation. Par défaut : le produit dont le handle est « coffret »."
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Page de protection des données"
    }
  ],
  "presets": [
    { "name": "Coffret, formulaire" }
  ]
}
{% endschema %}
