<section class="bookclub-page bc-wave" data-section-id="{{ section.id }}">
  <svg class="bc-wave__curve" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,90 C360,40 1080,140 1440,70 L1440,160 L0,160 Z"></path>
  </svg>
  <div class="bc-wave__books" aria-hidden="true">
    <img class="bc-wave__book" style="left:4%; width:80px; height:112px; transform: rotate(-3deg);" src="{{ 'bookclub-wave-b1.webp' | asset_url }}" alt="" width="80" height="112" loading="lazy">
    <img class="bc-wave__book" style="left:20%; width:64px; height:90px; transform: rotate(2deg);" src="{{ 'bookclub-wave-b2.webp' | asset_url }}" alt="" width="64" height="90" loading="lazy">
    <img class="bc-wave__book" style="left:36%; width:88px; height:122px; transform: rotate(0deg);" src="{{ 'bookclub-wave-b3.webp' | asset_url }}" alt="" width="88" height="122" loading="lazy">
    <img class="bc-wave__book" style="left:53%; width:60px; height:84px; transform: rotate(-2deg);" src="{{ 'bookclub-wave-b4.webp' | asset_url }}" alt="" width="60" height="84" loading="lazy">
    <img class="bc-wave__book" style="left:70%; width:78px; height:108px; transform: rotate(3deg);" src="{{ 'bookclub-wave-b5.webp' | asset_url }}" alt="" width="78" height="108" loading="lazy">
    <img class="bc-wave__book" style="left:85%; width:70px; height:98px; transform: rotate(-1deg);" src="{{ 'bookclub-wave-b6.webp' | asset_url }}" alt="" width="70" height="98" loading="lazy">
  </div>
</section>

{% schema %}
{
  "name": "Book Club, transition",
  "tag": "section",
  "class": "bookclub-wave-section",
  "settings": [],
  "presets": [
    { "name": "Book Club, transition" }
  ]
}
{% endschema %}
