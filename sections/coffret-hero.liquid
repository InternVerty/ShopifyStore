{{ 'coffret-landing.css' | asset_url | stylesheet_tag }}

<section class="coffret-page cf-hero" data-section-id="{{ section.id }}">
  <div class="cf-hero__grid">
    <div class="cf-hero__text">
      {%- if section.settings.badge != blank -%}
        <span class="cf-hero__kicker">{{ section.settings.badge | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="cf-hero__title">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <div class="cf-hero__sub">{{ section.settings.subtext }}</div>
      {%- endif -%}
      <div class="cf-hero__price">
        {%- if section.settings.price != blank -%}<span class="cf-hero__price-amount">{{ section.settings.price | escape }}</span>{%- endif -%}
        {%- if section.settings.price_note != blank -%}<span class="cf-hero__price-ship">{{ section.settings.price_note | escape }}</span>{%- endif -%}
      </div>
      <div class="cf-hero__cta">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url | default: '/pages/coffret' }}" class="cf-btn cf-btn--lg">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.share_label != blank -%}
          <a href="{{ section.settings.share_url | default: '#partager' }}" class="cf-sharelink">
            {% render 'coffret-landing-icon', name: 'share', size: 18 %}
            {{ section.settings.share_label | escape }}
          </a>
        {%- endif -%}
      </div>
      <div class="cf-hero__tags">
        {%- for block in section.blocks -%}
          <span class="cf-hero__tag" {{ block.shopify_attributes }}>
            <span class="cf-hero__tag-icon">{% render 'coffret-landing-icon', name: block.settings.icon, size: 17 %}</span>{{ block.settings.label | escape }}
          </span>
        {%- endfor -%}
      </div>
    </div>

    <div class="cf-hero__visual">
      <div class="cf-hero__frame">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" srcset="{{ section.settings.image | image_url: width: 640 }} 640w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1280 }} 1280w" sizes="(max-width: 640px) 80vw, 40vw" alt="{{ section.settings.image.alt | default: section.settings.image_alt | escape }}" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}" loading="eager">
        {%- else -%}
          <img src="{{ 'coffret-landing-hero.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="638" height="900" loading="eager">
        {%- endif -%}
      </div>
      {%- if section.settings.float_right_title != blank -%}
        <div class="cf-hero__float cf-hero__float--right">
          <div class="cf-hero__float-icon">{% render 'coffret-landing-icon', name: 'stars', size: 22 %}</div>
          <div>
            <div class="cf-hero__float-title">{{ section.settings.float_right_title | escape }}</div>
            <div class="cf-hero__float-text">{{ section.settings.float_right_text | escape }}</div>
          </div>
        </div>
      {%- endif -%}
      {%- if section.settings.float_left_title != blank -%}
        <div class="cf-hero__float cf-hero__float--left">
          <div class="cf-hero__float-icon">{% render 'coffret-landing-icon', name: 'check', size: 22 %}</div>
          <div>
            <div class="cf-hero__float-title">{{ section.settings.float_left_title | escape }}</div>
            <div class="cf-hero__float-text">{{ section.settings.float_left_text | escape }}</div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Coffret, hero",
  "tag": "div",
  "class": "coffret-hero-section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Nouveau : Noël & anniversaires" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Le Coffret Verty, des livres choisis spécialement pour lui." },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Texte",
      "default": "<p>Un vrai cadeau autour du livre, <strong>composé spécialement pour l'enfant par le comité Verty</strong>. Vous nous parlez de lui, nous choisissons, vous validez.</p>"
    },
    { "type": "text", "id": "price", "label": "Prix", "default": "39,00€" },
    { "type": "text", "id": "price_note", "label": "Mention sous le prix", "default": "+ 4,90€ de livraison" },
    { "type": "text", "id": "cta_label", "label": "Bouton principal", "default": "Je commande son coffret" },
    { "type": "url", "id": "cta_url", "label": "Lien du bouton principal", "info": "Par défaut : /pages/coffret" },
    { "type": "text", "id": "share_label", "label": "Lien secondaire", "default": "Envoyer cette idée cadeau" },
    { "type": "text", "id": "share_url", "label": "Cible du lien secondaire", "default": "#partager" },
    { "type": "header", "content": "Illustration" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Sans image, l'illustration du design est utilisée." },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif", "default": "Des enfants s'envolent d'un coffret Verty avec leurs livres" },
    { "type": "header", "content": "Cartes flottantes" },
    { "type": "text", "id": "float_right_title", "label": "Carte haute, titre", "default": "Choisi par le comité" },
    { "type": "text", "id": "float_right_text", "label": "Carte haute, texte", "default": "selon son âge et ses passions" },
    { "type": "text", "id": "float_left_title", "label": "Carte basse, titre", "default": "Validé par vous" },
    { "type": "text", "id": "float_left_text", "label": "Carte basse, texte", "default": "la sélection par mail avant l'envoi" }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Point fort",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "book", "label": "Livre" },
            { "value": "notebook", "label": "Carnet" },
            { "value": "gift", "label": "Cadeau" }
          ],
          "default": "book"
        },
        { "type": "text", "id": "label", "label": "Texte", "default": "2 ou 3 livres choisis pour lui" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coffret, hero",
      "blocks": [
        { "type": "tag", "settings": { "icon": "book", "label": "2 ou 3 livres choisis pour lui" } },
        { "type": "tag", "settings": { "icon": "notebook", "label": "Le carnet du lecteur" } },
        { "type": "tag", "settings": { "icon": "gift", "label": "Rien à emballer" } }
      ]
    }
  ]
}
{% endschema %}
