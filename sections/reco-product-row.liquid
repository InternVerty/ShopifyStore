{%- comment -%}
  Section fragment — rendu via Section Rendering API uniquement.
  Ne pas ajouter directement à une page.

  Appelé par 3-products-reco.liquid :
    fetch('/products/{handle}?sections=reco-product-row')

  Le contexte de la page produit rend `product` disponible avec tous ses
  metafields custom (note_du_comite, avis_comite, auteur…).
  Les classes CSS (.reco-3p__*) sont déjà chargées par 3-products-reco.liquid.
{%- endcomment -%}

{%- liquid
  assign note            = product.metafields.custom.note_du_comite | default: 5
  assign note_int        = note | times: 1
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'reco-atc-row-' | append: product.id
-%}

<div class="reco-3p__row">

  {%- comment -%} ── Col 1 : Image ── {%- endcomment -%}
  <div class="reco-3p__img-col">
    <a href="{{ product.url }}" class="reco-3p__img-link" aria-label="{{ product.title | escape }}" tabindex="-1">
      {%- if product.featured_image -%}
        <img
          src="{{ product.featured_image | image_url: width: 400 }}"
          alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
          width="200"
          height="{{ 200 | divided_by: product.featured_image.aspect_ratio | round }}"
          loading="lazy"
        >
      {%- else -%}
        {{ 'image' | placeholder_svg_tag }}
      {%- endif -%}
    </a>
  </div>

  {%- comment -%} ── Col 2 : Infos ── {%- endcomment -%}
  <div class="reco-3p__info-col">

    <a href="{{ product.url }}" class="reco-3p__title">
      {{- product.title | escape -}}
    </a>

    {%- if product.metafields.custom.auteur != blank -%}
      <p class="reco-3p__author">{{ product.metafields.custom.auteur }}</p>
    {%- endif -%}

    {%- comment -%} ── Note étoiles ── {%- endcomment -%}
    <div class="reco-3p__note">
      <div class="etoiles-product">
        {%- if note_int == 3 -%}
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile empty"></span>
          <span class="etoile empty"></span>
        {%- elsif note_int == 4 -%}
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile empty"></span>
        {%- else -%}
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile full"></span>
          <span class="etoile full"></span>
        {%- endif -%}
      </div>
      <div class="texte-note">
        Note du <a
          href="https://verty.eu/pages/le-comite-de-lecture-verty"
          target="_blank"
          rel="noopener"
        ><strong class="hover-highlight">comité de lecture</strong></a>
      </div>
    </div>

    {%- comment -%} ── Avis du comité ── {%- endcomment -%}
    {%- if product.metafields.custom.avis_comite != blank -%}
      <div class="reco-3p__avis-wrap">
        <div class="reco-3p__avis">
          {{- product.metafields.custom.avis_comite -}}
        </div>
        <button type="button" class="reco-3p__avis-btn" hidden>
          Voir plus
        </button>
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} ── Col 3 : Prix + ATC ── {%- endcomment -%}
  <div class="reco-3p__price-col">

    {%- render 'price', product: product -%}

    {%- if product.has_only_default_variant -%}
      <product-form>
        <div class="alert mb-8 bg-error-bg text-error-text js-form-error text-start" role="alert" hidden></div>
        {%- form 'product', product, class: 'js-product-form', id: product_form_id, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" disabled>
          <button
            class="btn btn--primary w-full"
            name="add"
            aria-haspopup="dialog"
            data-add-to-cart-text="{{ 'products.product.add_to_cart' | t | escape }}"
            {%- if current_variant.available == false %} disabled{%- endif %}
          >
            <span class="quick-add-btn-text">
              {{- 'products.product.add_to_cart' | t -}}
            </span>
          </button>
        {%- endform -%}
      </product-form>
    {%- else -%}
      <button
        type="button"
        class="btn btn--primary w-full js-quick-add"
        aria-haspopup="dialog"
        data-product-url="{{ product.url }}"
        data-product-default-variant="{{ product.has_only_default_variant }}"
      >
        <span class="quick-add-btn-text block pointer-events-none">
          {{- 'products.product.choose_options' | t -}}
        </span>
      </button>
    {%- endif -%}

    <a href="{{ product.url }}" class="btn btn--secondary">
      {{- 'products.product.view_details' | t -}}
    </a>

  </div>

</div>

{% schema %}
{
  "name": "Reco Product Row"
}
{% endschema %}
