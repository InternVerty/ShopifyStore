{%- comment -%}
  Custom Popup — sections/custom-popup.liquid
  Éditable depuis le customiseur Shopify.
  À inclure UNE FOIS dans layout/theme.liquid juste avant </body> :
    {% section 'custom-popup' %}
{%- endcomment -%}

{%- liquid
  assign title        = section.settings.title
  assign text         = section.settings.text
  assign btn_label    = section.settings.button_label
  assign heading_font = section.settings.heading_font
  assign body_font    = section.settings.body_font

  assign bg          = section.settings.bg_color
  assign bg_opacity  = section.settings.bg_opacity | divided_by: 100.0

  assign btn_bg         = section.settings.btn_bg_color
  assign btn_bg_opacity = section.settings.btn_bg_opacity | divided_by: 100.0

  assign custom_font = section.settings.font_family_custom

  assign excluded = section.settings.to_exclude | split: ", "
-%}


{% unless excluded contains handle %} 
  {%- if title != blank or text != blank or btn_label != blank -%}

    {{- heading_font | font_face -}}
    {{- body_font    | font_face -}}

    {%- style -%}

      /* ── Modal ── */
      #cp-{{ section.id }} .custom-popup__modal {
        background-color: rgba({{ bg.red }}, {{ bg.green }}, {{ bg.blue }}, {{ bg_opacity }});
        border-radius:    {{ section.settings.modal_radius }}px;
        border:           {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
        max-width:        {{ section.settings.popup_max_width }}px;
      }

      /* ── Image du haut ── */
      #cp-{{ section.id }} .custom-popup__image img {
        border-radius: {{ section.settings.image_top_radius }}px;
        max-height:    {{ section.settings.image_top_height }}px;
      }

      /* ── Titre ── */
      #cp-{{ section.id }} .custom-popup__title {
        color:       {{ section.settings.title_color }};
        font-family: oldblue, sans-serif;
        font-weight: 300;
        font-style:  {{ heading_font.style }};
        font-size:   {{ section.settings.heading_size }};
      }

      /* ── Texte ── */
      #cp-{{ section.id }} .custom-popup__text {
        color:       {{ section.settings.text_color }};
        font-family: Satoshi;
        font-weight: {{ body_font.weight }};
        font-size:   {{ section.settings.text_size }};
      }

      /* ── Bouton ── */
      #cp-{{ section.id }} .custom-popup__btn {
        background-color: rgba({{ btn_bg.red }}, {{ btn_bg.green }}, {{ btn_bg.blue }}, {{ btn_bg_opacity }});
        color:            {{ section.settings.btn_text_color }};
        border-radius:    {{ section.settings.btn_radius }}px;
        width:            {{ section.settings.btn_width }};
        padding:          {{ section.settings.btn_padding_v }}px {{ section.settings.btn_padding_h }}px;
      }

      /* ── Image du bas ── */
      #cp-{{ section.id }} .custom-popup__image-bottom img {
        border-radius: {{ section.settings.image_bottom_radius }}px;
        max-height:    {{ section.settings.image_bottom_height }}px;
      }

      /* ── Croix de fermeture ── */
      #cp-{{ section.id }} .custom-popup__close {
        color: {{ section.settings.close_color }};
      }

    {%- endstyle -%}

    <custom-popup
      id="cp-{{ section.id }}"
      class="custom-popup {{ section.settings.position }}"
      data-trigger="{{ section.settings.trigger }}"
      data-delay="{{ section.settings.delay }}"
      data-dismiss-days="{{ section.settings.dismiss_days }}"
      data-show-on-mobile="{{ section.settings.show_on_mobile }}">

      <div class="custom-popup__overlay js-popup-overlay" aria-hidden="true"></div>

      <div class="custom-popup__modal"
          role="dialog"
          aria-modal="true"
          aria-labelledby="cp-title-{{ section.id }}"
          tabindex="-1">

        <button type="button" class="custom-popup__close js-popup-close" aria-label="{{ 'accessibility.close' | t }}">
          &times;
        </button>

        {%- if section.settings.image != blank -%}
          <div class="custom-popup__image">
            {{- section.settings.image | image_url: width: 1080 | image_tag:
                loading: 'lazy',
                alt: section.settings.image.alt | escape
            -}}
          </div>
        {%- endif -%}

        <div class="custom-popup__content">

          {%- if title != blank -%}
            <h2 class="custom-popup__title" id="cp-title-{{ section.id }}">
              {{- title | escape -}}
            </h2>
          {%- endif -%}

          {%- if text != blank -%}
            <div class="custom-popup__text">
              {{- text -}}
            </div>
          {%- endif -%}

          {%- if btn_label != blank -%}
            <div class="custom-popup__btn-wrap">
              <a class="custom-popup__btn"
                href="{{ section.settings.button_url | default: '#' }}"
                {%- if section.settings.button_url != blank %} aria-label="{{ btn_label | escape }}"{% endif %}>
                {{- btn_label | escape -}}
              </a>
            </div>
          {%- endif -%}

          {%- if section.settings.bottom_text != blank -%}
            <p class="custom-popup__bottom-text">{{ section.settings.bottom_text | escape }}</p>
          {%- endif -%}

        </div>

        {%- if section.settings.image_bottom != blank -%}
          <div class="custom-popup__image-bottom">
            {{- section.settings.image_bottom | image_url: width: 800 | image_tag:
                loading: 'lazy',
                alt: section.settings.image_bottom.alt | escape
            -}}
          </div>
        {%- endif -%}

      </div>
    </custom-popup>

    {{ 'custom-popup.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'custom-popup.js' | asset_url }}" defer="defer"></script>

  {%- endif -%}
{% endunless %}
{% schema %}
{
  "name": "Popup custom",
  "tag": "section",
  "class": "cc-custom-popup",
  "settings": [

    {
      "type": "header",
      "content": "⚙️ Déclencheur"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Type de déclencheur",
      "options": [
        { "value": "delay", "label": "Délai automatique" },
        { "value": "exit",  "label": "Exit intent" }
      ],
      "default": "delay",
      "info": "\"Exit intent\" ne fonctionne pas sur mobile."
    },
    {
      "type": "range",
      "id": "delay",
      "label": "Délai avant affichage",
      "info": "Uniquement pour le déclencheur \"Délai\".",
      "default": 3,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s"
    },

    {
      "type": "header",
      "content": "👁️ Visibilité"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Afficher sur mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "dismiss_days",
      "label": "Jours avant réaffichage",
      "info": "0 = afficher une seule fois.",
      "default": 7,
      "min": 0,
      "max": 30,
      "step": 1
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position sur la page",
      "options": [
        { "value": "custom-popup--center",        "label": "Centre"      },
        { "value": "custom-popup--bottom-center", "label": "Bas centre"  },
        { "value": "custom-popup--bottom-left",   "label": "Bas gauche"  },
        { "value": "custom-popup--bottom-right",  "label": "Bas droite"  },
        { "value": "custom-popup--top-center",    "label": "Haut centre" }
      ],
      "default": "custom-popup--bottom-left"
    },
    {
      "type": "range",
      "id": "popup_max_width",
      "label": "Largeur max du popup",
      "default": 400,
      "min": 240,
      "max": 600,
      "step": 10,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "🖼️ Image du haut"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (logo, illustration…)"
    },
    {
      "type": "range",
      "id": "image_top_height",
      "label": "Hauteur max",
      "default": 120,
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_top_radius",
      "label": "Arrondi des coins",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "✏️ Titre"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Texte du titre",
      "default": "Bienvenue !"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille",
      "options": [
        { "value": "24px",    "label": "Petit"      },
        { "value": "28px", "label": "Moyen"      },
        { "value": "32px", "label": "Grand"      },
        { "value": "38px", "label": "Très grand" }
      ],
      "default": "32px"
    },

    {
      "type": "header",
      "content": "📝 Texte / Description"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Contenu",
      "default": "<p>Découvrez notre collection.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur",
      "default": "#333333"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Police",
      "default": "helvetica_n4"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Taille",
      "options": [
        { "value": "12px",   "label": "Petit"  },
        { "value": "16px",  "label": "Normal" },
        { "value": "18px",   "label": "Grand"  }
      ],
      "default": "16px"
    },

    {
      "type": "header",
      "content": "🔘 Bouton"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien"
    },
    {
      "type": "select",
      "id": "btn_width",
      "label": "Largeur du bouton",
      "options": [
        { "value": "auto",  "label": "Ajusté au texte" },
        { "value": "100%",  "label": "Pleine largeur"  }
      ],
      "default": "100%"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Arrondi des coins",
      "default": 50,
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "btn_padding_v",
      "label": "Hauteur (padding vertical)",
      "info": "Espace en haut et en bas du texte du bouton.",
      "default": 13,
      "min": 6,
      "max": 30,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "btn_padding_h",
      "label": "Largeur (padding horizontal)",
      "info": "Espace à gauche et à droite du texte du bouton.",
      "default": 28,
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Couleur du fond",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "btn_bg_opacity",
      "label": "Opacité du fond",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Couleur du texte",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "🖼️ Image du bas"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Image (illustration…)"
    },
    {
      "type": "range",
      "id": "image_bottom_height",
      "label": "Hauteur max",
      "default": 180,
      "min": 40,
      "max": 400,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_bottom_radius",
      "label": "Arrondi des coins",
      "default": 0,
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Texte sous le bouton (optionnel)",
      "info": "Petit texte affiché entre le bouton et l'image du bas."
    },

    {
      "type": "header",
      "content": "🎨 Fond du popup"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur (hex)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "bg_opacity",
      "label": "Opacité",
      "default": 100,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "🔲 Bordure du popup"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Couleur (hex)",
      "default": "#e0e0e0"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Épaisseur",
      "default": 0,
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "modal_radius",
      "label": "Arrondi des coins du popup",
      "default": 12,
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "close_color",
      "label": "Couleur de la croix de fermeture",
      "default": "#111111"
    },

    {
      "type": "header",
      "content": "Paramètre d'affichage"
    },
    {
      "type": "text",
      "id": "to_exclude",
      "label": "Handle des pages sur lesquels le popup ne s'affiche pas (séparés par ', ')"
    }

  ],
  "presets": [
    {
      "name": "Popup custom"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
