<section class="bookclub-page bc-discussion" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="bc-discussion__header">
      {%- if section.settings.kicker != blank -%}<p class="bc-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="bc-section-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}
        {%- assign bc_intro_lines = section.settings.intro | split: "
" -%}
        {%- for bc_intro_line in bc_intro_lines -%}
          {%- assign bc_intro_line_trim = bc_intro_line | strip -%}
          {%- if bc_intro_line_trim != blank -%}<p class="bc-discussion__intro">{{ bc_intro_line_trim | escape }}</p>{%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="bc-discussion__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          <div class="bc-card bc-discussion__card" {{ block.shopify_attributes }}>
            <span class="bc-discussion__card-icon">{% render 'icon', icon: block.settings.icon, width: 24, height: 24 %}</span>
            <h3 class="bc-discussion__card-title">{{ block.settings.title | escape }}</h3>
            <p class="bc-discussion__card-text">{{ block.settings.text | escape }}</p>
            <div class="bc-discussion__masked">
              <div class="bc-discussion__masked-line"><span>&ldquo;</span><span class="bc-discussion__masked-bar" style="width: 94%;"></span></div>
              <div class="bc-discussion__masked-line"><span>&ldquo;</span><span class="bc-discussion__masked-bar" style="width: 78%;"></span></div>
              <div class="bc-discussion__masked-line"><span>&ldquo;</span><span class="bc-discussion__masked-bar" style="width: 86%;"></span></div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Book Club, guide séance",
  "tag": "section",
  "class": "bookclub-discussion-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Le guide de séance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Les questions qui font parler les enfants"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Texte d'intro (retour à la ligne = nouveau paragraphe)",
      "default": "Le guide Verty accompagne le parent pas à pas pour organiser et animer chaque séance, avec un déroulé clair, des idées de jeux et des questions adaptées à l'âge des enfants.\nLes plus grands peuvent même s'appuyer sur le guide pour animer eux-mêmes leur séance."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Carte",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "chat_bubble", "label": "Chat bubble" },
            { "value": "feather", "label": "Feather" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "chat_bubble"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Book Club, guide séance",
      "blocks": [
        { "type": "card", "settings": { "icon": "feather", "title": "D'abord, entrer dans le livre", "text": "Une question simple aide chaque enfant à partager ce qu'il a compris, aimé ou ressenti, sans crainte de mal répondre." } },
        { "type": "card", "settings": { "icon": "chat_bubble", "title": "Ensuite, échanger ensemble", "text": "Le groupe rebondit, confronte ses avis et s'écoute grâce à des questions qui relancent la discussion et font parler les enfants autour du livre." } }
      ]
    }
  ]
}
{% endschema %}
