<style>
  #shopify-section-{{ section.id }} .qb-page {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 48px;
    background-color: {{ section.settings.section_background }};
    box-sizing: border-box;
    font-family: 'Ubuntu', system-ui, sans-serif;
  }

  #shopify-section-{{ section.id }} .qb-band {
    position: relative;
    display: block;
    border-radius: 22px;
    padding: 44px 48px;
    max-width: 660px;
    width: 100%;
    overflow: hidden;
    box-sizing: border-box;
    letter-spacing: -0.01em;
  }

  #shopify-section-{{ section.id }} .qb-mark {
    position: absolute;
    top: 12px;
    right: 36px;
    font-family: Georgia, serif;
    font-size: 128px;
    line-height: 128px;
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
    display: block;
  }

  #shopify-section-{{ section.id }} .qb-text {
    margin: 0;
    padding: 0;
    font-size: 28px;
    font-weight: 500;
    line-height: 40px;
    text-wrap: pretty;
    position: relative;
  }

  #shopify-section-{{ section.id }} .qb-cite {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 26px;
    font-size: 16px;
    line-height: 22px;
  }

  #shopify-section-{{ section.id }} .qb-portrait {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0px 4px 12px rgba(10, 10, 10, 0.18);
    background-color: rgba(10, 10, 10, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .qb-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #shopify-section-{{ section.id }} .qb-portrait svg {
    width: 26px;
    height: 26px;
    opacity: 0.35;
  }

  #shopify-section-{{ section.id }} .qb-name {
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .qb-role {
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .qb-page {
      padding: 24px 16px;
    }

    #shopify-section-{{ section.id }} .qb-band {
      padding: 32px 28px;
    }

    #shopify-section-{{ section.id }} .qb-text {
      font-size: 22px;
      line-height: 34px;
    }

    #shopify-section-{{ section.id }} .qb-mark {
      font-size: 96px;
      line-height: 96px;
    }
  }
</style>

<div class="qb-page">
  <figure
    class="qb-band"
    style="background-color: {{ section.settings.card_background }}; color: {{ section.settings.text_color }};"
  >
    <span class="qb-mark" aria-hidden="true">&ldquo;</span>

    <p class="qb-text">{{ section.settings.quote_text }}</p>

    <figcaption class="qb-cite">
      <div class="qb-portrait">
        {%- if section.settings.author_image -%}
          {{
            section.settings.author_image
            | image_url: width: 88
            | image_tag:
              width: 44,
              height: 44,
              loading: 'lazy',
              alt: section.settings.author_name
          }}
        {%- else -%}
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm0 2c-5.33 0-8 2.67-8 4v1h16v-1c0-1.33-2.67-4-8-4Z"/>
          </svg>
        {%- endif -%}
      </div>

      <span>
        <span class="qb-name">{{ section.settings.author_name }}</span>
        {%- if section.settings.author_role != blank -%}
          <span class="qb-role">, {{ section.settings.author_role }}</span>
        {%- endif -%}
      </span>
    </figcaption>
  </figure>
</div>

{% schema %}
{
  "name": "Quote Band",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Quote"
    },
    {
      "type": "textarea",
      "id": "quote_text",
      "label": "Quote text",
      "default": "Tell me, what is it you plan to do with your one wild and precious life?"
    },
    {
      "type": "header",
      "content": "Author"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author portrait"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Mary Oliver"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Source / title",
      "default": "The Summer Day",
      "info": "Displayed after the author name, e.g. ', The Summer Day'"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#97E8C7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0A0A0A"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Quote Band"
    }
  ]
}
{% endschema %}
