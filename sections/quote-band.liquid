<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet">

<style>
  .qb-band-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .qb-band-{{ section.id }} .qb-quiet {
    position: relative;
    overflow: hidden;
    border-left: 4px solid {{ section.settings.accent_color }};
    background: {{ section.settings.accent_color }}1A;
    border-radius: 0 15px 15px 0;
    padding: 30px 64px 30px 32px;
    max-width: 620px;
    margin: 16px 40px;
  }

  .qb-band-{{ section.id }} .qb-mark {
    position: absolute;
    top: 4px;
    right: 24px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 120px;
    line-height: 120px;
    color: {{ section.settings.accent_color }};
    opacity: 0.35;
    pointer-events: none;
    user-select: none;
  }

  .qb-band-{{ section.id }} .qb-text {
    font-family: 'Ubuntu', system-ui, sans-serif;
    font-size: 25px;
    line-height: 37px;
    color: #182233;
    letter-spacing: -0.01em;
    text-wrap: pretty;
    margin: 0;
    position: relative;
  }

  .qb-band-{{ section.id }} .qb-text em {
    font-style: normal;
    font-weight: 500;
    box-shadow: {{ section.settings.accent_color }}1A 0px -12.5px 0px 0px inset;
  }

  .qb-band-{{ section.id }} .qb-cite {
    display: block;
    margin-top: 20px;
    font-family: 'Ubuntu', system-ui, sans-serif;
    font-size: 16px;
    line-height: 22px;
    color: #6B7280;
  }

  .qb-band-{{ section.id }} .qb-name {
    font-weight: 700;
    color: #182233;
  }

  .qb-band-{{ section.id }} .qb-role {
    color: #6B7280;
    font-weight: 400;
  }
</style>

{%- liquid
  if section.settings.highlighted_phrase != blank
    assign em_open = '<em>'
    assign em_close = '</em>'
    assign em_wrapped = em_open | append: section.settings.highlighted_phrase | append: em_close
    assign quote_html = section.settings.quote | replace: section.settings.highlighted_phrase, em_wrapped
  else
    assign quote_html = section.settings.quote
  endif
-%}

<section class="qb-band-{{ section.id }}">
  <figure class="qb qb-quiet">
    <span class="qb-mark" aria-hidden="true">"</span>
    <p class="qb-text">{{ quote_html }}</p>
    <figcaption class="qb-cite">
      <span class="qb-name">{{ section.settings.author }}</span>
      {%- if section.settings.attribution != blank -%}
        <span class="qb-role">, {{ section.settings.attribution }}</span>
      {%- endif -%}
    </figcaption>
  </figure>
</section>

{% schema %}
{
  "name": "Quote Band",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Perfection is achieved, not when there is nothing more to add, but when there is nothing left to take away."
    },
    {
      "type": "text",
      "id": "highlighted_phrase",
      "label": "Highlighted phrase",
      "info": "Optional — paste the exact phrase to highlight with a teal underline effect"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Author",
      "default": "Antoine de Saint-Exupéry"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "info": "Optional — e.g. book title, role, or company",
      "default": "Terre des Hommes"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent colour",
      "default": "#8FCDBF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Quote Band"
    }
  ]
}
{% endschema %}
