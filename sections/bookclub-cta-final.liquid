<section class="bookclub-page bc-cta-final" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="bc-cta-final__panel">
      {%- if section.settings.kicker != blank -%}<p class="bc-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="bc-cta-final__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subtext != blank -%}<div class="bc-cta-final__text rte">{{ section.settings.subtext }}</div>{%- endif -%}
      <div class="bc-cta-final__actions">
        <button type="button" class="vbtn vbtn-primary vbtn-navy vbtn-lg" data-bookclub-open>{{ section.settings.cta_primary_label | escape }}</button>
        <a href="#fonctionnement" class="vbtn vbtn-secondary vbtn-navy vbtn-lg">{{ section.settings.cta_secondary_label | escape }}</a>
      </div>
      {%- if section.settings.signature != blank -%}
        <p class="bc-cta-final__signature">{{ section.settings.signature | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Book Club, CTA final",
  "tag": "section",
  "class": "bookclub-cta-final-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Prêt à lancer ?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Créez votre Book Club et invitez vos premières familles."
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Texte",
      "default": "<p>39 € par enfant et par an, kit complet inclus. Aucune expérience d'animation requise, Verty vous guide pas à pas.</p>"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Bouton principal",
      "default": "Créer mon Book Club"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Bouton secondaire",
      "default": "Revoir le fonctionnement"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "Lire ensemble, c'est lire plus longtemps."
    }
  ]
}
{% endschema %}
