{{ 'bookclub.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bookclub-signup.js' | asset_url }}" defer="defer"></script>

{%- liquid
  # Si la page est rendue pour une entrée du metaobject "bookclub" (storefront
  # page), on lit les vraies données du club. Sinon (page générique de test),
  # on retombe sur les réglages/blocks de la section, comme avant.
  if metaobject
    assign club_token = metaobject.system.handle
    assign club_name = metaobject.name.value
    assign organizer_name = metaobject.organizer_name.value
    assign organizer_email = metaobject.organizer_email.value
    assign organizer_customer_id = metaobject.organizer_customer_id.value
    assign city = metaobject.city.value
    assign target = metaobject.target_size.value
    assign launch_month = metaobject.launch_month.value
    assign club_members = metaobject.members.value
    assign members_count = club_members.size
    assign invite_url = shop.url | append: metaobject.system.url
    assign next_session_date = metaobject.next_session_date.value
    assign next_session_number = metaobject.next_session_number.value
    assign club_state = metaobject.state.value | default: 'opened'
  else
    assign club_token = blank
    assign club_name = section.settings.club_name
    assign organizer_name = section.settings.organizer_name
    assign organizer_email = section.settings.organizer_email
    assign organizer_customer_id = section.settings.organizer_customer_id
    assign city = section.settings.city
    assign target = section.settings.target_size
    assign launch_month = section.settings.launch_month
    assign club_members = blank
    assign members_count = section.blocks.size
    assign invite_url = section.settings.invite_url
    assign next_session_date = section.settings.next_session_date
    assign next_session_number = section.settings.next_session_number
    assign club_state = section.settings.club_state | default: 'opened'
  endif

  assign progress = 0
  if target > 0
    assign progress = members_count | times: 100 | divided_by: target
  endif
  if progress > 100
    assign progress = 100
  endif

  # Forcer en chaîne pour une comparaison fiable avec customer_id
  # (metaobject, "Une ligne de texte"), customer.id étant un nombre en Liquid.
  assign viewer_customer_id = customer.id | append: ''

  # L'état du club (opened / full / started) est géré côté backend et fait
  # foi : il pilote l'affichage du widget hero, la vue "À faire" de
  # l'organisateur et le blocage de l'inscription, plutôt qu'un calcul local
  # basé sur le nombre de membres.
  assign is_prep = false
  if club_state == 'opened'
    assign is_prep = true
  endif
  assign is_full = false
  if club_state == 'full'
    assign is_full = true
  endif
  assign is_started = false
  if club_state == 'started'
    assign is_started = true
  endif
  assign is_join_blocked = false
  if is_full or is_started
    assign is_join_blocked = true
  endif

  # La carte "Membres" ne doit jamais charger de données d'enfants réelles
  # tant que le visiteur n'est pas identifié comme une famille du club (pas
  # connecté) ou une fois le club complet/lancé (confidentialité).
  assign hide_members = false
  if is_join_blocked or customer == blank
    assign hide_members = true
  endif

  assign is_organizer = false
  if customer and organizer_customer_id != blank and viewer_customer_id == organizer_customer_id
    assign is_organizer = true
  endif
  assign viewer_email_lower = customer.email | downcase
  assign organizer_email_lower = organizer_email | downcase
  if customer and organizer_email != blank and customer.email != blank and viewer_email_lower == organizer_email_lower
    assign is_organizer = true
  endif
  if section.settings.preview_as_organizer
    assign is_organizer = true
  endif

  # Statut de paiement + inscription du visiteur courant, calculés une seule
  # fois ici pour être réutilisés à la fois dans la liste des membres et dans
  # la liste "À faire".
  # Une même famille peut avoir plusieurs enfants inscrits : on ne doit pas
  # se contenter du dernier enfant traité dans la boucle, sinon un enfant payé
  # peut masquer le paiement en attente d'un autre enfant du même compte.
  assign viewer_is_member = false
  assign viewer_has_pending = false
  assign pending_count = 0
  assign pending_names_list = ''
  if metaobject
    for m in club_members
      assign m_paid_raw = m.paiement_confirm.value
      assign m_paid_str = m_paid_raw | append: ''
      assign m_is_paid = false
      if m_paid_raw == true or m_paid_str == 'Vrai' or m_paid_str == 'true' or m_paid_str == 'True'
        assign m_is_paid = true
      endif
      unless m_is_paid
        assign pending_count = pending_count | plus: 1
        if pending_names_list == blank
          assign pending_names_list = m.prenom.value
        else
          assign pending_names_list = pending_names_list | append: '||' | append: m.prenom.value
        endif
      endunless
      if customer and m.customer_id.value == viewer_customer_id
        assign viewer_is_member = true
        unless m_is_paid
          assign viewer_has_pending = true
        endunless
      endif
    endfor
  endif
  assign pending_names = pending_names_list | split: '||'

  assign state_label = 'En préparation'
  if is_full
    assign state_label = 'Complet'
  elsif is_started
    assign state_label = 'Saison en cours'
  endif
  assign role_label = 'Membre'
  if is_organizer
    assign role_label = 'Organisateur'
  endif

  # Compteur "À faire" (calculé avant l'affichage pour le compteur X / Y et
  # la barre de progression, sans dupliquer les conditions d'affichage).
  assign todo_done = 0
  assign todo_total = 0
  if is_organizer and is_prep
    assign todo_total = 3 | plus: pending_count
    if viewer_is_member
      assign todo_done = todo_done | plus: 1
    endif
    if members_count > 1
      assign todo_done = todo_done | plus: 1
    endif
  elsif is_organizer
    assign todo_total = 3
  else
    assign todo_total = 2
    assign todo_done = 2
    if viewer_has_pending
      assign todo_total = todo_total | plus: 1
    endif
  endif
  assign todo_pct = 0
  if todo_total > 0
    assign todo_pct = todo_done | times: 100 | divided_by: todo_total
  endif
-%}
<section class="bookclub-page bc-dash" data-section-id="{{ section.id }}">
  <nav class="bc-breadcrumb" aria-label="Fil d'ariane">
    <div class="container">
      <a class="bc-breadcrumb__link" href="https://verty.eu/pages/mon-compte">{% render 'icon-chevron-left' %}Mon compte</a>
      <span class="bc-breadcrumb__sep">/</span>
      <span class="bc-breadcrumb__current" aria-current="page">{{ club_name | escape }}</span>
    </div>
  </nav>

  <div class="bc-dash__hero">
    <div class="container bc-dash__hero-inner">
      <div class="bc-dash__hero-main">
        <p class="bc-dash__hero-kicker">
          Book Club Verty
          <span class="bc-dash__hero-dot" aria-hidden="true"></span>
          {{ state_label }}
        </p>
        <h1 class="bc-dash__hero-title">{{ club_name | escape }}</h1>
        <p class="bc-dash__hero-subtitle">Organisé par {{ organizer_name | escape }}{% if city != blank %}, {{ city }}{% endif %}</p>
        {%- if customer -%}
          <div class="bc-dash__hero-pills">
            <span class="bc-dash__hero-pill is-active">{{ state_label }}</span>
            <span class="bc-dash__hero-pill is-active">{{ role_label }}</span>
          </div>
        {%- endif -%}
        <div class="bc-dash__hero-actions">
          {%- if is_join_blocked -%}
            <p class="bc-dash__hero-blocked">
              {%- if is_full -%}
                Ce club est complet, il n'accepte plus de nouvelles familles.
              {%- else -%}
                Ce club a déjà démarré sa saison, les inscriptions sont closes.
              {%- endif -%}
            </p>
          {%- else -%}
            <button type="button" class="vbtn vbtn-primary vbtn-invite vbtn-lg" data-bookclub-open>{% render 'icon', icon: 'gift', width: 18, height: 18 %}{{ section.settings.cta_label | escape }}</button>
          {%- endif -%}
        </div>
      </div>
      <div class="bc-dash__hero-side">
        <div class="bc-dash__hero-books" aria-hidden="true">
          <img class="bc-dash__hero-book bc-dash__hero-book--1" src="{{ 'bookclub-dash-b1.webp' | asset_url }}" alt="" width="68" height="102" loading="lazy">
          <img class="bc-dash__hero-book bc-dash__hero-book--2" src="{{ 'bookclub-dash-b2.webp' | asset_url }}" alt="" width="68" height="102" loading="lazy">
          <img class="bc-dash__hero-book bc-dash__hero-book--3" src="{{ 'bookclub-dash-b3.webp' | asset_url }}" alt="" width="68" height="102" loading="lazy">
          <img class="bc-dash__hero-book bc-dash__hero-book--4" src="{{ 'bookclub-dash-b4.webp' | asset_url }}" alt="" width="68" height="102" loading="lazy">
        </div>
        <div class="bc-dash__hero-widget-wrap">
          {%- if club_token != blank -%}
            <div class="bc-dash__hero-code">
              <div class="bc-dash__hero-code-text">
                <span class="bc-dash__hero-code-label">Code du bookclub</span>
                <span class="bc-dash__hero-code-value">{{ club_token | upcase }}</span>
              </div>
              <button type="button" class="bc-dash__hero-share" data-bookclub-share data-invite-url="{{ invite_url | escape }}" data-club-name="{{ club_name | escape }}" aria-label="Partager le lien d'invitation">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="18" cy="5" r="3"></circle>
                  <circle cx="6" cy="12" r="3"></circle>
                  <circle cx="18" cy="19" r="3"></circle>
                  <line x1="8.6" y1="10.6" x2="15.4" y2="6.4"></line>
                  <line x1="8.6" y1="13.4" x2="15.4" y2="17.6"></line>
                </svg>
              </button>
            </div>
          {%- endif -%}
          <div class="bc-dash__hero-widget">
            {%- if is_prep -%}
              <p class="bc-dash__hero-widget-label">
                Membres
                <span class="bc-dash__hero-info" tabindex="0">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9"></circle>
                    <line x1="12" y1="11" x2="12" y2="16.5"></line>
                    <circle cx="12" cy="7.5" r="0.5" fill="currentColor"></circle>
                  </svg>
                  <span class="bc-dash__hero-info-tooltip">Le club peut être lancé à tout moment : atteindre 8 familles n'est pas obligatoire.</span>
                </span>
              </p>
              <p class="bc-dash__hero-widget-value">{{ members_count }}</p>
              <div class="bc-dash__hero-widget-bar"><div class="bc-dash__hero-widget-fill" style="width: {{ progress }}%;"></div></div>
            {%- else -%}
              <p class="bc-dash__hero-widget-label">Prochaine séance</p>
              {%- if next_session_date != blank -%}
                <p class="bc-dash__hero-widget-value bc-dash__hero-widget-value--text">{{ next_session_date | escape }}</p>
                {%- if next_session_number != blank and next_session_number > 0 -%}
                  <p class="bc-dash__hero-widget-sub">Séance {{ next_session_number }}</p>
                {%- endif -%}
              {%- else -%}
                <p class="bc-dash__hero-widget-value bc-dash__hero-widget-value--text">À définir</p>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container">
        <div class="bc-dash__grid3">
          <div class="bc-card bc-dash__panel">
            <div class="bc-dash__panel-head">
              <h3 class="bc-dash__panel-title">Membres</h3>
              {%- if is_organizer and hide_members == false -%}
                <button type="button" class="bc-dash__link-btn" data-bookclub-copy-invite data-invite-url="{{ invite_url | escape }}"><span data-copy-label>+ Inviter</span></button>
              {%- endif -%}
            </div>
            {%- if hide_members -%}
              {%- comment -%}
                Club complet/lancé, ou visiteur non connecté : par souci de
                confidentialité, on n'affiche jamais les enfants inscrits (ni
                ne charge leurs données dans le HTML) en dehors du cas où le
                visiteur est identifié comme une famille du club. Le nombre de
                rangées factices ci-dessous est fixe et ne reflète pas
                l'effectif réel du club.
              {%- endcomment -%}
              <div class="bc-dash__members-hidden">
                <div class="bc-dash__members bc-dash__members--blurred" aria-hidden="true">
                  <div class="bc-dash__member"><span class="bc-dash__member-avatar"></span><div class="bc-dash__member-info"><div class="bc-dash__member-name">••••••</div><div class="bc-dash__member-meta">•• ••••, •••</div></div></div>
                  <div class="bc-dash__member"><span class="bc-dash__member-avatar"></span><div class="bc-dash__member-info"><div class="bc-dash__member-name">••••••</div><div class="bc-dash__member-meta">•• ••••, •••</div></div></div>
                  <div class="bc-dash__member"><span class="bc-dash__member-avatar"></span><div class="bc-dash__member-info"><div class="bc-dash__member-name">••••••</div><div class="bc-dash__member-meta">•• ••••, •••</div></div></div>
                </div>
                <div class="bc-dash__members-overlay">
                  {%- if customer == blank -%}
                    <p>Connectez-vous pour voir les membres de ce club.</p>
                    <div class="bc-account-choice">
                      <a href="{{ routes.account_login_url }}?return_to={{ request.path | url_encode }}" class="vbtn vbtn-primary vbtn-navy vbtn-sm">Se connecter</a>
                      <a href="{{ routes.account_register_url }}?return_to={{ request.path | url_encode }}" class="vbtn vbtn-secondary vbtn-navy vbtn-sm">Créer un compte</a>
                    </div>
                  {%- else -%}
                    <p>Les membres ne sont plus affichés une fois le club complet ou lancé.</p>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <div class="bc-dash__members">
                {%- if metaobject -%}
                  {%- for member in club_members -%}
                    {%- liquid
                      assign mc_ci = forloop.index0 | modulo: 4
                      assign mc_age = ''
                      if member.naissance.value != blank
                        assign mc_birth_ts = member.naissance.value | date: '%s' | plus: 0
                        assign mc_now_ts = 'now' | date: '%s' | plus: 0
                        assign mc_age = mc_now_ts | minus: mc_birth_ts | divided_by: 31557600
                      endif
                      assign mc_meta_parts = ''
                      if mc_age != blank
                        assign mc_meta_parts = mc_age | append: ' ans'
                      endif
                      if member.classe.value != blank
                        if mc_meta_parts != blank
                          assign mc_meta_parts = mc_meta_parts | append: ', '
                        endif
                        assign mc_meta_parts = mc_meta_parts | append: member.classe.value
                      endif
                      if member.niveau.value != blank
                        if mc_meta_parts != blank
                          assign mc_meta_parts = mc_meta_parts | append: ', '
                        endif
                        assign mc_meta_parts = mc_meta_parts | append: member.niveau.value
                      endif
                      assign bc_paid = member.paiement_confirm.value
                      assign bc_paid_str = bc_paid | append: ''
                      assign bc_is_paid = false
                      if bc_paid == true or bc_paid_str == 'Vrai' or bc_paid_str == 'true' or bc_paid_str == 'True'
                        assign bc_is_paid = true
                      endif
                    -%}
                    <div class="bc-dash__member">
                      <span class="bc-dash__member-avatar bc-dash__member-avatar--{{ mc_ci }}">{{ member.prenom.value | slice: 0 | upcase }}</span>
                      <div class="bc-dash__member-info">
                        <div class="bc-dash__member-name">{{ member.prenom.value | escape }}</div>
                        <div class="bc-dash__member-meta">{{ mc_meta_parts | escape }}</div>
                        {%- unless bc_is_paid -%}
                          <span class="bc-dash__member-pending">En attente</span>
                        {%- endunless -%}
                      </div>
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'member' -%}
                      {%- assign mc_ci = forloop.index0 | modulo: 4 -%}
                      <div class="bc-dash__member" {{ block.shopify_attributes }}>
                        <span class="bc-dash__member-avatar bc-dash__member-avatar--{{ mc_ci }}">{{ block.settings.prenom | slice: 0 | upcase }}</span>
                        <div class="bc-dash__member-info">
                          <div class="bc-dash__member-name">{{ block.settings.prenom | escape }}</div>
                          <div class="bc-dash__member-meta">{{ block.settings.meta | escape }}</div>
                          {%- if block.settings.paiement_confirm == false -%}
                            <span class="bc-dash__member-pending">En attente</span>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- assign remaining = target | minus: members_count -%}
                {%- if is_organizer and is_prep and remaining > 0 -%}
                  <button type="button" class="bc-dash__member bc-dash__member--empty" data-bookclub-copy-invite data-invite-url="{{ invite_url | escape }}">
                    <span class="bc-dash__member-avatar bc-dash__member-avatar--empty">{% render 'icon', icon: 'gift', width: 16, height: 16 %}</span>
                    <div class="bc-dash__member-name">{{ remaining }} place{% if remaining > 1 %}s{% endif %} libre{% if remaining > 1 %}s{% endif %}</div>
                  </button>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          <div class="bc-dash__col">
            <div class="bc-card bc-dash__panel">
              <div class="bc-dash__panel-head">
                <h3 class="bc-dash__panel-title">À faire</h3>
                <span class="bc-dash__todo-count">{{ todo_done }} / {{ todo_total }}</span>
              </div>
              <div class="bc-dash__todo-bar"><div class="bc-dash__todo-fill" style="width: {{ todo_pct }}%;"></div></div>
              <ul class="bc-dash__todo-list">
                {%- if is_organizer and is_prep -%}
                  <li class="bc-dash__todo-item{% if viewer_is_member %} is-done{% endif %}"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Renseigner un enfant lecteur</li>
                  <li class="bc-dash__todo-item{% if members_count > 1 %} is-done{% endif %}"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Inviter d'autres familles à rejoindre</li>
                  <li class="bc-dash__todo-item"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Valider le groupe et recevoir le kit</li>
                  {%- for name in pending_names -%}
                    <li class="bc-dash__todo-item"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Paiement de {{ name | escape }} en attente</li>
                  {%- endfor -%}
                {%- elsif is_organizer -%}
                  <li class="bc-dash__todo-item"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Planifier la prochaine séance</li>
                  <li class="bc-dash__todo-item"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Envoyer un rappel aux familles</li>
                  <li class="bc-dash__todo-item"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Vérifier la rotation des livres</li>
                {%- else -%}
                  <li class="bc-dash__todo-item is-done"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Mon inscription est confirmée</li>
                  <li class="bc-dash__todo-item is-done"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Profil lecteur renseigné</li>
                  {%- if viewer_has_pending -%}
                    <li class="bc-dash__todo-item"><span class="bc-dash__todo-icon">{% render 'icon', icon: 'check_mark', width: 11, height: 11 %}</span>Mon paiement est en attente</li>
                  {%- endif -%}
                {%- endif -%}
              </ul>
            </div>

            <div class="bc-dash__invite">
              <div class="bc-dash__invite-label">Lien d'invitation</div>
              <div class="bc-dash__invite-row">
                <span class="bc-dash__invite-url">{{ invite_url | escape }}</span>
                <button type="button" class="vbtn vbtn-primary vbtn-navy vbtn-sm" data-bookclub-copy-invite data-invite-url="{{ invite_url | escape }}"><span data-copy-label>Copier</span></button>
              </div>
            </div>
          </div>

          <div class="bc-card bc-dash__panel">
            <h3 class="bc-dash__panel-title">Ressources</h3>
            <ul class="bc-dash__resources">
              <li><span>{% render 'icon', icon: 'gift', width: 18, height: 18 %}Sélection de livres</span></li>
              <li><span>{% render 'icon', icon: 'feather', width: 18, height: 18 %}Carnet du lecteur</span></li>
              <li><span>{% render 'icon', icon: 'heart', width: 18, height: 18 %}Marque-page</span></li>
              <li><span>{% render 'icon', icon: 'box', width: 18, height: 18 %}Tote bag</span></li>
              <li><span>{% render 'icon', icon: 'calendar', width: 18, height: 18 %}Guide de séances</span></li>
              <li><span>{% render 'icon', icon: 'truck', width: 18, height: 18 %}Fiche de rotation</span></li>
              <li><span>{% render 'icon', icon: 'star', width: 18, height: 18 %}Fiches livres</span></li>
            </ul>
          </div>
        </div>
  </div>
</section>

{% render 'bookclub-join-modal', club_name: club_name, club_token: club_token %}

<script>
(function () {
  document.querySelectorAll('[data-bookclub-copy-invite]').forEach(function (btn) {
    var label = btn.querySelector('[data-copy-label]');
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-invite-url');
      navigator.clipboard.writeText(url).then(function () {
        if (!label) return;
        var original = label.textContent;
        label.textContent = 'Copié';
        setTimeout(function () { label.textContent = original; }, 1600);
      });
    });
  });

  document.querySelectorAll('[data-bookclub-share]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-invite-url');
      var title = btn.getAttribute('data-club-name') || 'Book Club Verty';

      if (navigator.share) {
        navigator.share({ title: title, url: url }).catch(function () {});
        return;
      }

      navigator.clipboard.writeText(url).then(function () {
        btn.classList.add('is-copied');
        setTimeout(function () { btn.classList.remove('is-copied'); }, 1600);
      });
    });
  });

})();
</script>

{% schema %}
{
  "name": "Book Club, dashboard",
  "tag": "section",
  "class": "bookclub-dashboard-section",
  "settings": [
    {
      "type": "text",
      "id": "club_name",
      "label": "Nom du club",
      "default": "Les Explorateurs du mercredi"
    },
    {
      "type": "text",
      "id": "organizer_name",
      "label": "Organisateur",
      "default": "Camille"
    },
    {
      "type": "text",
      "id": "organizer_email",
      "label": "E-mail de l'organisateur",
      "info": "Utilisé pour détecter si le visiteur connecté est l'organisateur du club."
    },
    {
      "type": "text",
      "id": "organizer_customer_id",
      "label": "ID client de l'organisateur",
      "info": "Optionnel, si ce champ existe côté metaobject bookclub."
    },
    {
