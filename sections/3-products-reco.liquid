{%- comment -%}
  Section : 3 Produits Recommandés

  Layout par ligne :
    [Image] | [Titre + Auteur + Note + Avis du comité] | [Prix + ATC + Achat rapide]

  Configuration : renseignez les handles dans les réglages de la section
  (Personnaliser le thème → réglages de la section).

  Usage URL override (JS) : ?p1=handle-1&p2=handle-2&p3=handle-3
{%- endcomment -%}

{{ 'custom-featured-collection.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if settings.enable_quick_add -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<style>
  /* ════════════════════════════════════════════════════════════
     STYLING 
     ════════════════════════════════════════════════════════════ */
  .reco-3p {
    --img-col:      200px;   /* largeur de la colonne image          */
    --price-col:    220px;   /* largeur de la colonne prix/boutons   */
    --row-gap:       28px;   /* espace horizontal entre les colonnes */
    --row-padding: 20px 24px;/* padding interne de chaque ligne      */
    --font-title:   3rem;  /* titre du livre                       */
    --font-body:   1.5rem;  /* auteur + avis                        */
    --font-small:  1rem;  /* label "Note du comité"               */
    --font-price:   3rem;  /* prix affiché                         */
  }
  /* ════════════════════════════════════════════════════════════ */

  /* ── Section ──────────────────────────────────────────────── */
  .reco-3p {
    padding: 40px 0;
  }

  .reco-3p__heading {
    font-family: "oldblue", sans-serif;
    font-size: 3rem;
    font-weight: 400;
    margin-bottom: 28px;
  }

  /* ── Liste des 3 lignes ───────────────────────────────────── */
  .reco-3p__grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ── Ligne : 3 colonnes ───────────────────────────────────── */
  .reco-3p__row {
    display: grid;
    grid-template-columns: var(--img-col) 1fr var(--price-col);
    grid-template-areas: "img info price";
    gap: var(--row-gap);
    align-items: center;
    padding: var(--row-padding);
    border-radius: 12px;
    background-color: rgba(143, 205, 191, 0.08);
    transition: background-color 0.2s ease;
  }

  .reco-3p__row:hover {
    background-color: rgba(143, 205, 191, 0.16);
  }

  /* ── Colonne 1 : Image ────────────────────────────────────── */
  .reco-3p__img-col {
    grid-area: img;
  }

  .reco-3p__img-link {
    display: block;
  }

  .reco-3p__img-link img,
  .reco-3p__img-link svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    object-fit: cover;
  }

  /* ── Colonne 2 : Infos ────────────────────────────────────── */
  .reco-3p__info-col {
    grid-area: info;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    border-right: 1px solid rgba(143, 205, 191, 0.35);
    padding-right: var(--row-gap);
  }

  .reco-3p__title {
    font-weight: 700;
    font-size: var(--font-title);
    line-height: 1.35;
    margin: 0;
    text-decoration: none;
    color: inherit;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .reco-3p__title:hover {
    text-decoration: underline;
  }

  .reco-3p__author {
    font-size: var(--font-body);
    color: #666;
    margin: 0;
  }

  /* ── Note étoiles ─────────────────────────────────────────── */
  .reco-3p__note {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .reco-3p__note .etoiles-product {
    flex-shrink: 0;
  }

  .reco-3p__note .texte-note {
    margin-top: 0;
    font-size: var(--font-small);
  }

  /* ── Avis du comité ──────────────────────────────────────── */
  .reco-3p__avis {
    font-size: var(--font-body);
    line-height: 1.55;
    color: #444;
    margin: 0;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .reco-3p__avis.is-expanded {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .reco-3p__avis-btn {
    display: inline-block;
    margin-top: 4px;
    padding: 0;
    background: none;
    border: none;
    font-size: var(--font-small);
    color: #8FCDBF;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .reco-3p__avis-btn:hover {
    color: #6ab5a5;
  }

  /* ── Colonne 3 : Prix + Boutons ───────────────────────────── */
  .reco-3p__price-col {
    grid-area: price;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: stretch;
  }

  .reco-3p__price-col .price {
    font-size: var(--font-price);
    text-align: center;
  }

  .reco-3p__price-col .btn {
    width: 100%;
    text-align: center;
  }

  /* ── Responsive : tablet ──────────────────────────────────── */
  @media (max-width: 900px) {
    .reco-3p {
      --img-col:    140px;
      --price-col:  170px;
      --row-gap:     18px;
      --row-padding: 18px 20px;
      --font-title: 1.05rem;
    }
  }

  /* ── Responsive : mobile ──────────────────────────────────── */
  @media (max-width: 640px) {
    .reco-3p {
      --img-col:    90px;
      --row-gap:    12px;
      --row-padding: 14px;
    }

    .reco-3p__row {
      grid-template-columns: var(--img-col) 1fr;
      grid-template-areas:
        "img info"
        "price price";
    }

    .reco-3p__info-col {
      border-right: none;
      padding-right: 0;
    }

    .reco-3p__price-col {
      flex-direction: row;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .reco-3p__price-col .price {
      flex-shrink: 0;
    }

    .reco-3p__price-col .btn {
      flex: 1;
    }
  }
</style>

{%- liquid
  assign handle_1 = section.settings.handle_1
  assign handle_2 = section.settings.handle_2
  assign handle_3 = section.settings.handle_3
-%}

<div
  class="container reco-3p"
  id="reco-3p-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-handle-1="{{ handle_1 }}"
  data-handle-2="{{ handle_2 }}"
  data-handle-3="{{ handle_3 }}"
>

  {%- if section.settings.title != blank -%}
    <h2 class="reco-3p__heading">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="reco-3p__grid" id="reco-3p-grid-{{ section.id }}">

    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign handle = handle_1
          when 2
            assign handle = handle_2
          when 3
            assign handle = handle_3
        endcase

        if handle != blank
          assign product = all_products[handle]
          assign note        = product.metafields.custom.note_du_comite | default: 5
          assign note_int    = note | times: 1
          assign current_variant = product.selected_or_first_available_variant
          assign product_form_id = 'reco-atc-' | append: section.id | append: '-' | append: product.id
        endif
      -%}

      {%- if handle != blank and product and product != empty -%}

        <div class="reco-3p__row">

          {%- comment -%} ── Col 1 : Image ── {%- endcomment -%}
          <div class="reco-3p__img-col">
            <a href="{{ product.url }}" class="reco-3p__img-link" aria-label="{{ product.title | escape }}" tabindex="-1">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
                  width="200"
                  height="{{ 200 | divided_by: product.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
          </div>

          {%- comment -%} ── Col 2 : Infos ── {%- endcomment -%}
          <div class="reco-3p__info-col">

            <a href="{{ product.url }}" class="reco-3p__title">
              {{- product.title | escape -}}
            </a>

            {%- if product.metafields.custom.auteur != blank -%}
              <p class="reco-3p__author">{{ product.metafields.custom.auteur }}</p>
            {%- endif -%}

            {%- comment -%} ── Note étoiles ── {%- endcomment -%}
            <div class="reco-3p__note">
              <div class="etoiles-product">
                {%- if note_int == 3 -%}
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile empty"></span>
                  <span class="etoile empty"></span>
                {%- elsif note_int == 4 -%}
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile empty"></span>
                {%- else -%}
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                  <span class="etoile full"></span>
                {%- endif -%}
              </div>
              <div class="texte-note">
                Note du <a
                  href="https://verty.eu/pages/le-comite-de-lecture-verty"
                  target="_blank"
                  rel="noopener"
                ><strong class="hover-highlight">comité de lecture</strong></a>
              </div>
            </div>

            {%- comment -%} ── Avis du comité ── {%- endcomment -%}
            {%- if product.metafields.custom.avis_comite != blank -%}
              <div class="reco-3p__avis-wrap">
                <div class="reco-3p__avis">
                  {{- product.metafields.custom.avis_comite -}}
                </div>
                <button type="button" class="reco-3p__avis-btn" hidden>
                  Voir plus
                </button>
              </div>
            {%- endif -%}

          </div>

          {%- comment -%} ── Col 3 : Prix + ATC ── {%- endcomment -%}
          <div class="reco-3p__price-col">

            {%- render 'price', product: product -%}

            {%- if product.has_only_default_variant -%}
              {%- comment -%} Variante unique → ATC direct {%- endcomment -%}
              <product-form>
                <div class="alert mb-8 bg-error-bg text-error-text js-form-error text-start" role="alert" hidden></div>
                {%- form 'product', product, class: 'js-product-form', id: product_form_id, novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" disabled>
                  <button
                    class="btn btn--primary w-full"
                    name="add"
                    aria-haspopup="dialog"
                    data-add-to-cart-text="{{ 'products.product.add_to_cart' | t | escape }}"
                    {%- if current_variant.available == false %} disabled{%- endif %}
                  >
                    <span class="quick-add-btn-text">
                      {{- 'products.product.add_to_cart' | t -}}
                    </span>
                  </button>
                {%- endform -%}
              </product-form>
            {%- else -%}
              {%- comment -%} Plusieurs variantes → ouvre le drawer quick-add {%- endcomment -%}
              <button
                type="button"
                class="btn btn--primary w-full js-quick-add"
                aria-haspopup="dialog"
                data-product-url="{{ product.url }}"
                data-product-default-variant="{{ product.has_only_default_variant }}"
              >
                <span class="quick-add-btn-text block pointer-events-none">
                  {{- 'products.product.choose_options' | t -}}
                </span>
              </button>
            {%- endif -%}

            <a href="{{ product.url }}" class="btn btn--secondary">
              {{- 'products.product.view_details' | t -}}
            </a>

          </div>

        </div>

      {%- endif -%}
    {%- endfor -%}

  </div>
</div>

{%- comment -%}
  ── Override URL params (JS) ──────────────────────────────────────────────────
  ⚠️  /products/{handle}.js ne retourne pas les metafields custom.
      L'avis et la note du comité ne seront pas disponibles en mode URL params.
      Pour le rendu complet, utiliser les réglages de section.
  ─────────────────────────────────────────────────────────────────────────────
{%- endcomment -%}

<script>
/* ── Bouton "Voir plus" sur l'avis du comité ─────────────────── */
(function () {
  document.querySelectorAll('#reco-3p-grid-{{ section.id }} .reco-3p__avis-wrap').forEach(function (wrap) {
    var avis = wrap.querySelector('.reco-3p__avis');
    var btn  = wrap.querySelector('.reco-3p__avis-btn');
    if (!avis || !btn) return;

    /* Affiche le bouton seulement si le texte déborde */
    if (avis.scrollHeight > avis.clientHeight + 2) {
      btn.hidden = false;
      btn.addEventListener('click', function () {
        avis.classList.add('is-expanded');
        btn.hidden = true;
      });
    }
  });
})();

/* ── Override URL params ─────────────────────────────────────── */
(function () {
  var params   = new URLSearchParams(window.location.search);
  var handles  = [params.get('p1'), params.get('p2'), params.get('p3')];
  var anyParam = handles.some(function (h) { return h && h.trim() !== ''; });
  if (!anyParam) return;

  var grid      = document.getElementById('reco-3p-grid-{{ section.id }}');
  var container = document.getElementById('reco-3p-{{ section.id }}');
  if (!grid) return;

  var fallbacks = [
    container.dataset.handle1,
    container.dataset.handle2,
    container.dataset.handle3,
  ];

  var finalHandles = handles.map(function (h, i) {
    return (h && h.trim() !== '') ? h.trim() : (fallbacks[i] || '');
  });

  grid.innerHTML = '';

  finalHandles.forEach(function (handle) {
    if (!handle) return;

    fetch('/products/' + handle + '.js')
      .then(function (r) { return r.json(); })
      .then(function (p) {
        var price = p.price_min ? (p.price_min / 100).toFixed(2).replace('.', ',') + ' €' : '';
        var img   = p.featured_image
          ? '<img src="' + p.featured_image + '" alt="' + p.title + '" loading="lazy">'
          : '';
        var atcBtn = p.variants && p.variants.length === 1
          ? '<button class="btn btn--primary w-full" onclick="window.location=\'/products/' + p.handle + '\'">' +
              (p.variants[0].available ? 'Ajouter au panier' : 'Indisponible') +
            '</button>'
          : '<a href="/products/' + p.handle + '" class="btn btn--primary w-full">Choisir les options</a>';

        var row = document.createElement('div');
        row.className = 'reco-3p__row';
        row.innerHTML =
          '<div class="reco-3p__img-col">' +
            '<a href="/products/' + p.handle + '" class="reco-3p__img-link">' + img + '</a>' +
          '</div>' +
          '<div class="reco-3p__info-col">' +
            '<a href="/products/' + p.handle + '" class="reco-3p__title">' + p.title + '</a>' +
            '<p class="reco-3p__author">' + (p.vendor || '') + '</p>' +
            '<div class="reco-3p__note">' +
              '<div class="etoiles-product">' +
                '<span class="etoile full"></span><span class="etoile full"></span>' +
                '<span class="etoile full"></span><span class="etoile full"></span>' +
                '<span class="etoile full"></span>' +
              '</div>' +
              '<div class="texte-note">Note du <a href="https://verty.eu/pages/le-comite-de-lecture-verty" target="_blank" rel="noopener"><strong class="hover-highlight">comité de lecture</strong></a></div>' +
            '</div>' +
          '</div>' +
          '<div class="reco-3p__price-col">' +
            '<div class="price"><strong class="price__current">' + price + '</strong></div>' +
            atcBtn +
            '<a href="/products/' + p.handle + '" class="btn btn--secondary">Voir le produit</a>' +
          '</div>';

        grid.appendChild(row);
      })
      .catch(function (err) {
        console.warn('[reco-3p] Produit introuvable :', handle, err);
      });
  });
})();
</script>

{% schema %}
{
  "name": "3 Produits recommandés",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre de la section",
      "default": "Notre sélection"
    },
    {
      "type": "header",
      "content": "Produits à afficher"
    },
    {
      "type": "text",
      "id": "handle_1",
      "label": "Handle produit 1",
      "info": "Ex : mon-super-livre. Trouvable dans l'URL de la page produit."
    },
    {
      "type": "text",
      "id": "handle_2",
      "label": "Handle produit 2"
    },
    {
      "type": "text",
      "id": "handle_3",
      "label": "Handle produit 3"
    }
  ],
  "presets": [
    {
      "name": "3 Produits recommandés"
    }
  ]
}
{% endschema %}
