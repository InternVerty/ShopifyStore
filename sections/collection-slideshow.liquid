{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'slideshow.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'text-overlay.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'featured-collection.css' | asset_url }}" media="print" onload="this.media='all'">
{%- else -%}
  {{ 'slideshow.css' | asset_url | stylesheet_tag }}
  {{ 'text-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'featured-collection.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if section.blocks.size > 1 -%}
  <script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<script src="{{ 'slider.js' | asset_url }}" defer="defer"></script>

{%- if settings.enable_quick_add -%}
  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'product.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'custom-featured-collection.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'variant-picker.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign gutter_lg = 64
  assign breakpoint_sm = 600
  assign breakpoint_xxl = 1536
  assign breakpoint_sm_down = breakpoint_sm | minus: 0.02
  assign breakpoint_page = settings.max_page_width | default: 1320 | plus: gutter_lg | plus: gutter_lg

  assign color_scheme = section.settings.color_scheme
  assign bg_color = false
  if color_scheme == 'default'
    assign bg_color = settings.bg_color
  elsif color_scheme == '1'
    assign bg_color = settings.color_scheme_1_bg_grad | default: settings.color_scheme_1_bg
  elsif color_scheme == '2'
    assign bg_color = settings.color_scheme_2_bg_grad | default: settings.color_scheme_2_bg
  elsif color_scheme == '3'
    assign bg_color = settings.color_scheme_3_bg_grad | default: settings.color_scheme_3_bg
  endif
  if bg_color == 'rgba(0,0,0,0)'
    assign bg_color = false
  endif

  assign carousel_desktop_small = ' md:auto-cols-3 lg:auto-cols-4 xl:auto-cols-5 small-cards-desktop'
  assign carousel_desktop_medium = ' sm:auto-cols-3 xl:auto-cols-4'
  assign carousel_desktop_large = ' sm:auto-cols-2 lg:auto-cols-3'

  assign grid_desktop_small = ' md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 small-cards-desktop'
  assign grid_desktop_medium = ' sm:grid-cols-3 xl:grid-cols-4'
  assign grid_desktop_large = ' sm:grid-cols-2 lg:grid-cols-3'

  if section.settings.card_size_mobile == 'small'
    assign carousel_mobile_cols = 'grid-flow-col auto-cols-2 small-cards-mobile'
    assign grid_mobile_cols = 'grid-cols-2 small-cards-mobile'
  else
    assign carousel_mobile_cols = 'grid-flow-col auto-cols-1'
    assign grid_mobile_cols = 'grid-cols-1'
  endif

  if section.settings.layout == 'carousel'
    assign carousel = true
    if section.settings.card_size == 'small'
      assign grid_classes = carousel_mobile_cols | append: carousel_desktop_small
    elsif section.settings.card_size == 'medium'
      assign grid_classes = carousel_mobile_cols | append: carousel_desktop_medium
    else
      assign grid_classes = carousel_mobile_cols | append: carousel_desktop_large
    endif
  elsif section.settings.layout == 'carousel_on_mobile'
    assign carousel = true
    if section.settings.card_size == 'small'
      assign grid_classes = carousel_mobile_cols | append: grid_desktop_small
    elsif section.settings.card_size == 'medium'
      assign grid_classes = carousel_mobile_cols | append: grid_desktop_medium
    else
      assign grid_classes = carousel_mobile_cols | append: grid_desktop_large
    endif
  elsif section.settings.layout == 'grid'
    assign carousel = false
    if section.settings.card_size == 'small'
      assign grid_classes = grid_mobile_cols | append: grid_desktop_small
    elsif section.settings.card_size == 'medium'
      assign grid_classes = grid_mobile_cols | append: grid_desktop_medium
    else
      assign grid_classes = grid_mobile_cols | append: grid_desktop_large
    endif
  endif

  if settings.prod_card_image_ratio == 'shortest'
    assign default_image_ratio = 0
  elsif settings.prod_card_image_ratio == 'tallest'
    assign default_image_ratio = 99
  else
    assign default_image_ratio = settings.prod_card_image_ratio
  endif
-%}

{%- style -%}
  #{{ section.id }} slide-show {
    {%- if section.settings.autoplay -%}
      --duration: {{ section.settings.autoplay_speed }}s;
      --play-state: paused;
    {%- endif -%}
  }

  #{{ section.id }} .slideshow-ctrl {
    --text-color: {{ section.settings.pagination_color.red }} {{ section.settings.pagination_color.green }} {{ section.settings.pagination_color.blue }};
  }

  {%- if section.settings.height_mode == 'fixed' -%}
    @media (max-width: {{ breakpoint_sm_down }}px) {
      #{{ section.id }} .image-banner { min-height: {{ section.settings.fixed_height_mobile }}px; }
    }
    @media (min-width: {{ breakpoint_sm }}px) {
      #{{ section.id }} .image-banner {
        min-height: calc({{ section.settings.fixed_height_mobile }}px + ({{ section.settings.fixed_height_desktop }} - {{ section.settings.fixed_height_mobile }}) * ((100vw - {{ breakpoint_sm }}px) / {{ breakpoint_xxl | minus: breakpoint_sm }}));
      }
    }
    @media (min-width: {{ breakpoint_page }}px) {
      #{{ section.id }} .image-banner { min-height: {{ section.settings.fixed_height_desktop }}px; }
    }
  {%- elsif section.settings.height_mode == 'auto' -%}
    {%- liquid
      if section.blocks.first.settings.image_desktop != blank
        assign img_padding = 1 | divided_by: section.blocks.first.settings.image_desktop.aspect_ratio | times: 100 | append: '%'
      else
        assign img_padding = '56.25%'
      endif
      if section.blocks.first.settings.image_mobile != blank
        assign m_img_padding = 1 | divided_by: section.blocks.first.settings.image_mobile.aspect_ratio | times: 100 | append: '%'
      else
        assign m_img_padding = img_padding
      endif
    -%}
    #{{ section.id }} .image-banner::after,
    #{{ section.id }} .media::after { content: ''; padding-top: {{ img_padding }}; }

    {%- if section.blocks.first.settings.image_mobile != blank -%}
      @media (max-width: {{ breakpoint_sm }}px) {
        #{{ section.id }} .image-banner::after,
        #{{ section.id }} .media::after { content: ''; padding-top: {{ m_img_padding }}; }
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.tint_opacity > 0 -%}
    #{{ section.id }} .media::after {
      background-color: rgba({{ section.settings.tint_color.red }}, {{ section.settings.tint_color.green }}, {{ section.settings.tint_color.blue }}, {{ section.settings.tint_opacity | divided_by: 100.0 }});
    }
  {%- endif -%}

  {%- if bg_color -%}
    #{{ section.id }} .text-overlay { background: {{ bg_color }}; }
  {%- endif -%}
{%- endstyle -%}

<collection-slideshow class="block{% unless color_scheme == 'default' %} color-scheme color-scheme--{{ color_scheme }}{% endunless %}" id="{{ section.id }}">

  <!-- Hero banner slideshow -->
  <div class="slideshow-section section {% if section.settings.full_width %}section--full-width{% else %}container{% endif %}">
    <slide-show class="block relative overflow-hidden"
                role="region"
                aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
                aria-label="{{ section.settings.accessibility_info | escape }}"
                data-autoplay="{{ section.settings.autoplay }}"
                data-speed="{{ section.settings.autoplay_speed }}"
                data-transition="{{ section.settings.transition }}">

      <div class="slideshow flex" id="slideshow-{{ section.id }}" aria-live="polite" aria-atomic="true">
        {%- for block in section.blocks -%}
          {%- liquid
            assign img = block.settings.image_desktop
            assign m_img = block.settings.image_mobile
            assign overlay_position = block.settings.overlay_position | split: ' '
            assign lazy_load = true
            if forloop.first and section.index == 1
              assign lazy_load = false
            endif
          -%}

          <div class="slideshow__slide{% if section.blocks.size == 1 %} slideshow__slide--no-pagination{% endif %}{% if forloop.first %} is-active{% endif %} image-banner flex w-full {{ overlay_position | last }} {{ section.settings.height_mode }}-height"
               role="group"
               aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
               aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
               {%- unless forloop.first %}tabindex="-1"{% endunless %}
               {%- if request.design_mode %}data-index="{{ forloop.index0 }}"{% endif %}
               {{ block.shopify_attributes }}>

            <div class="image-banner__image media media--has-overlay absolute top-0 left-0 w-full h-full has-motion">
              {%- if img != blank -%}
                {%- liquid
                  if section.settings.full_width
                    assign sizes = '(max-aspect-ratio: 1/2) 50vh, 100vw'
                  else
                    capture sizes
                      render 'sizes-attribute'
                    endcapture
                  endif
                  if m_img != blank
                    assign desktop_image_class = 'img-fit hidden sm:block'
                  else
                    assign desktop_image_class = 'img-fit'
                  endif
                -%}
                {%- if m_img != blank -%}
                  {%- render 'image',
                    image: m_img,
                    widths: '480, 980, 1200, 1400',
                    src_width: 980,
                    src_placeholder: true,
                    sizes: sizes,
                    class: 'img-fit sm:hidden',
                    lazy_load: lazy_load
                  -%}
                {%- endif -%}
                {%- render 'image',
                  image: img,
                  widths: '480, 980, 1200, 1400, 1600, 1920, 2560',
                  src_width: 1400,
                  src_placeholder: true,
                  sizes: sizes,
                  quality: 1,
                  class: desktop_image_class,
                  lazy_load: lazy_load
                -%}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
              <div class="slideshow__text container flex {{ overlay_position | first }}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
                <div class="text-overlay{% if bg_color %} text-overlay--bg{% endif %} {{ block.settings.overlay_text_align }} has-motion">
                  {%- if block.settings.subheading != blank -%}
                    <p class="text-overlay__block subheading">{{ block.settings.subheading | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="text-overlay__heading {{ block.settings.heading_size }}">
                      {% render 'multiline-text' with block.settings.heading %}
                    </h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="text-overlay__block rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <div class="text-overlay__buttons inline-flex flex-wrap items-start mt-4 {% if block.settings.overlay_text_align == 'text-start' %}justify-start{% elsif block.settings.overlay_text_align == 'text-end' %}justify-end{% else %}justify-center{% endif %}">
                      <a class="{{ block.settings.button_style }}" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}>
                        {{- block.settings.button_label | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          </div>
        {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="slideshow-ctrl container absolute flex {{ section.settings.nav_position }} w-full pointer-events-none no-js-hidden">
          {%- if section.settings.nav_style == 'slideshow_nav_dots' or section.settings.nav_style == 'slideshow_nav_lines' -%}
            <div class="slideshow-pagination flex items-center">
              {%- for block in section.blocks -%}
                <button class="page-btn" data-index="{{ forloop.index0 }}" aria-controls="slideshow-{{ section.id }}"{% if forloop.first %} aria-current="true"{% endif %}>
                  <span class="visually-hidden">{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}</span>
                  {%- if section.settings.nav_style == 'slideshow_nav_lines' -%}
                    <span class="page-btn__line block relative overflow-hidden pointer-events-none"></span>
                  {%- else -%}
                    <svg width="30" height="30" viewBox="0 0 30 30" fill="none" class="page-btn__circle block pointer-events-none">
                      <circle class="page-btn__fg-circle" cx="15" cy="15" r="3.5" />
                      <circle class="page-btn__bg-circle" cx="15" cy="15" r="6" />
                    </svg>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if section.settings.nav_style == 'arrows' or section.settings.autoplay -%}
            <div class="slideshow-nav flex items-center">
              {%- if section.settings.nav_style == 'arrows' -%}
                <button type="button" class="slideshow-nav__btn btn hidden md:block has-ltr-icon" name="prev" aria-controls="slideshow-{{ section.id }}">
                  <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                  {% render 'icon-chevron-left' %}
                </button>
                <div class="slideshow-nav__counter">
                  <span class="slideshow-nav__counter-current">1</span>
                  <span aria-hidden="true"> / </span>
                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                  <span class="slideshow-nav__counter-total">{{ section.blocks.size }}</span>
                </div>
              {%- endif -%}
              {%- if section.settings.autoplay -%}
                <div class="slideshow-nav__autoplay flex items-center {% unless section.settings.slider_pause %}hidden{% endunless %}">
                  <button type="button" class="slideshow-nav__btn autoplay-btn btn">
                    <span class="pause-icon block pointer-events-none">
                      <span class="visually-hidden">{{ 'sections.slideshow.pause' | t }}</span>
                      {% render 'icon-pause' %}
                    </span>
                    <span class="play-icon block pointer-events-none">
                      <span class="visually-hidden">{{ 'sections.slideshow.play' | t }}</span>
                      {% render 'icon-video' %}
                    </span>
                  </button>
                </div>
              {%- endif -%}
              {%- if section.settings.nav_style == 'arrows' -%}
                <button type="button" class="slideshow-nav__btn btn hidden md:block has-ltr-icon" name="next" aria-controls="slideshow-{{ section.id }}">
                  <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                  {% render 'icon-chevron-right' %}
                </button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </slide-show>
  </div>

  <!-- Product panels, one per slide, synced with the slideshow -->
  {%- for block in section.blocks -%}
    {%- assign panel_collection = block.settings.collection -%}
    <div class="collection-slideshow__panel section{% unless forloop.first %} hidden{% endunless %}" data-panel-index="{{ forloop.index0 }}">

      {%- if panel_collection != blank -%}
        {%- liquid
          if settings.prod_card_image_ratio == 'shortest'
            assign panel_image_ratio = 0
            for product in panel_collection.products limit: block.settings.products_to_show
              if product.featured_media.preview_image.aspect_ratio > panel_image_ratio
                assign panel_image_ratio = product.featured_media.preview_image.aspect_ratio
              endif
            endfor
          elsif settings.prod_card_image_ratio == 'tallest'
            assign panel_image_ratio = 99
            for product in panel_collection.products limit: block.settings.products_to_show
              if product.featured_media.preview_image.aspect_ratio < panel_image_ratio
                assign panel_image_ratio = product.featured_media.preview_image.aspect_ratio
              endif
            endfor
          else
            assign panel_image_ratio = settings.prod_card_image_ratio
          endif
        -%}

        {%- if section.settings.show_collection_header -%}
          <div class="container">
            <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
              <h2 class="h4 mb-0 flex-auto section__heading {{ section.settings.heading_align }}">{{ panel_collection.title }}</h2>
              {%- if section.settings.show_view_all -%}
                <a href="{{ panel_collection.url }}" class="link">{{ 'sections.featured_collection.view_all' | t }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if carousel -%}
          <carousel-slider class="carousel block" inactive{% if section.settings.layout == 'carousel_on_mobile' %} disable-desktop="true"{% endif %}>
            <div class="container relative featured-collection-products">
              <div class="slider" id="products-slider-{{ section.id }}-{{ forloop.index }}">
        {%- endif -%}

        <div class="container products-grid-container shrink-0">
          <ul class="{% if carousel %}slider__grid {% endif %}grid {{ grid_classes }}{% if section.settings.layout == 'carousel_on_mobile' and section.settings.card_size_mobile == 'small' and settings.card_contain %} sm:gap-x-theme sm:gap-y-8{% else %} gap-x-theme gap-y-8{% endif %}{% if section.settings.card_size_mobile == 'small' and settings.card_contain %} small__grid{% endif %}" role="list">
            {%- for product in panel_collection.products limit: block.settings.products_to_show -%}
              <li {% if carousel %}class="slider__item"{% endif %}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                {% render 'product-card', product: product, collection: panel_collection, image_ratio: panel_image_ratio, show_metafields: true %}
              </li>
            {%- else -%}
              {%- for i in (1..block.settings.products_to_show) -%}
                <li {% if carousel %}class="slider__item"{% endif %}>
                  {% render 'product-card', product: "", image_ratio: panel_image_ratio %}
                </li>
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        </div>

        {%- if carousel -%}
              </div>
              {%- if settings.slider_show_arrows != 'never' -%}
                <div class="slider-nav absolute top-middle end {% if settings.slider_show_arrows == 'hover' %}slider-nav--show-on-hover no-hover-hidden {% endif %}hidden md:block no-js-hidden">
                  <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="next" aria-controls="products-slider-{{ section.id }}-{{ forloop.index }}">
                    <span class="visually-hidden">{{ 'general.slider.next' | t }}</span>
                    {% render 'icon-chevron-right' %}
                  </button>
                  <button type="button" class="slider-nav__btn tap-target btn {{ settings.slider_button_style }} has-ltr-icon" name="prev" aria-controls="products-slider-{{ section.id }}-{{ forloop.index }}">
                    <span class="visually-hidden">{{ 'general.slider.previous' | t }}</span>
                    {% render 'icon-chevron-left' %}
                  </button>
                </div>
              {%- endif -%}
            </div>
          </carousel-slider>
        {%- endif -%}

      {%- else -%}

        <div class="container products-grid-container shrink-0">
          <ul class="{% if carousel %}slider__grid {% endif %}grid {{ grid_classes }} gap-x-theme gap-y-8" role="list">
            {%- for i in (1..block.settings.products_to_show) -%}
              <li {% if carousel %}class="slider__item"{% endif %}>
                {% render 'product-card', product: "", image_ratio: default_image_ratio %}
              </li>
            {%- endfor -%}
          </ul>
        </div>

      {%- endif -%}
    </div>
  {%- endfor -%}

</collection-slideshow>

<script>
  if (!customElements.get('collection-slideshow')) {
    class CollectionSlideshow extends HTMLElement {
      connectedCallback() {
        const slides = this.querySelectorAll('.slideshow__slide');
        const panels = this.querySelectorAll('.collection-slideshow__panel');

        if (slides.length <= 1 || panels.length === 0) return;

        const observer = new MutationObserver(() => {
          slides.forEach((slide, i) => {
            if (panels[i]) {
              panels[i].classList.toggle('hidden', !slide.classList.contains('is-active'));
            }
          });
        });

        slides.forEach(slide => {
          observer.observe(slide, { attributes: true, attributeFilter: ['class'] });
        });
      }
    }
    customElements.define('collection-slideshow', CollectionSlideshow);
  }
</script>

{% schema %}
{
  "name": "Collection slideshow",
  "tag": "section",
  "class": "cc-collection-slideshow",
  "settings": [
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "select",
      "id": "height_mode",
      "label": "Image height",
      "options": [
        { "value": "auto", "label": "Height of first image" },
        { "value": "fixed", "label": "Fixed height (set below)" },
        { "value": "screen", "label": "Full screen height" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "fixed_height_desktop",
      "min": 300,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "Fixed height on large screens",
      "default": 500
    },
    {
      "type": "range",
      "id": "fixed_height_mobile",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Fixed height on mobile",
      "default": 300
    },
    {
      "type": "select",
      "id": "nav_style",
      "label": "Pagination style",
      "options": [
        { "value": "arrows", "label": "Arrows" },
        { "value": "slideshow_nav_dots", "label": "Dots" },
        { "value": "slideshow_nav_lines", "label": "Lines" }
      ],
      "default": "slideshow_nav_lines"
    },
    {
      "type": "color",
      "id": "pagination_color",
      "label": "Pagination color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "nav_position",
      "label": "Pagination position",
      "options": [
        { "value": "justify-start", "label": "Left" },
        { "value": "justify-center", "label": "Center" },
        { "value": "justify-end", "label": "Right" }
      ],
      "default": "justify-center"
    },
    {
      "type": "select",
      "id": "transition",
      "label": "Slide transition",
      "options": [
        { "value": "slide-fade", "label": "Slide and fade" },
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide-fade"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "slider_pause",
      "label": "Show pause button",
      "info": "Only applies when auto-rotate is turned on.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Change slides every",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Collection header"
    },
    {
      "type": "checkbox",
      "id": "show_collection_header",
      "label": "Show collection header",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "text-start", "label": "Left" },
        { "value": "text-center", "label": "Center" },
